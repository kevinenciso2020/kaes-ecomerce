# URL pública del API (termina en /api/v1)
PUBLIC_API_URL=https://api.kaes-simplyeternal.co/api/v1

# Secreto de servidor compartido con el backend (NO usar prefijo PUBLIC_):
# identifica al SSR de Vercel para que el rate limit por IP no lo bloquee.
SSR_API_KEY=

# "strict" cuando front y API compartan dominio (kaes-simplyeternal.co / api.kaes-simplyeternal.co):
# /admin exigirá sesión válida ya en el servidor.
ADMIN_SSR_GUARD=
