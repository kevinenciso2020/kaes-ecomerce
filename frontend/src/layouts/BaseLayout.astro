---
import '../styles/global.css'
import { SITE_CONFIG } from '../lib/site-config.js'
import { absoluteUrl, isNoIndexPath, resolveSiteUrl, safeJsonForScript, truncateDescription } from '../lib/seo.js'

interface Props {
  title:       string
  description?:string | undefined
  image?:      string | undefined   // URL absoluta para Open Graph / Twitter
  type?:       'website' | 'product'
  noindex?:    boolean
  jsonLd?:     Record<string, unknown> | undefined
}

const { title, description = 'Tienda de ropa online', image: imageProp, type = 'website', noindex, jsonLd } = Astro.props

// URL canónica sin query string (filtros, utm…). Con SITE_URL configurado
// (astro.config) apunta siempre al dominio principal aunque se visite el
// sitio por *.vercel.app.
const siteUrl      = resolveSiteUrl(Astro.site, Astro.url.origin)
const canonicalUrl = absoluteUrl(siteUrl, Astro.url.pathname)
// Imagen por defecto (logo de Kaes) cuando la página no define una propia
const image        = imageProp ?? absoluteUrl(siteUrl, '/kaes.jpeg')
const metaDescription =truncateDescription(description)
const fullTitle    = `${title} | Kaes Store`
const robots       = noindex ?? isNoIndexPath(Astro.url.pathname) ? 'noindex, nofollow' : 'index, follow'
---

<!DOCTYPE html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <meta name="theme-color" content="#ffffff" />
    <meta name="color-scheme" content="light" />
    <meta name="description" content={metaDescription} />
    <meta name="robots" content={robots} />
    <title>{fullTitle}</title>
    <link rel="canonical" href={canonicalUrl} />
    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <link rel="icon" type="image/png" href="/favicon-48.png" sizes="48x48" />
    <link rel="icon" type="image/png" href="/favicon-192.png" sizes="192x192" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="sitemap" type="application/xml" href="/sitemap.xml" />

    <meta property="og:site_name" content={SITE_CONFIG.name} />
    <meta property="og:locale" content="es_CO" />
    <meta property="og:type" content={type} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={metaDescription} />
    <meta property="og:url" content={canonicalUrl} />
    {image && <meta property="og:image" content={image} />}
    <meta name="twitter:card" content={image ? 'summary_large_image' : 'summary'} />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={metaDescription} />
    {image && <meta name="twitter:image" content={image} />}
    {jsonLd && <script type="application/ld+json" set:html={safeJsonForScript(jsonLd)} />}
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,500..800&family=Hanken+Grotesk:wght@400;500;600;700&display=swap" rel="stylesheet" />
  </head>
  <body>
    <a href="#main-content" class="skip-link">Saltar al contenido</a>
    <slot />

    <script>
      import '../lib/bootstrap.js'
    </script>
  </body>
</html>