---
import { SITE_CONFIG } from '../../lib/site-config.js'

const socials = [
  {
    key: 'instagram',
    label: 'Instagram',
    href: SITE_CONFIG.social.instagram,
    icon: `<rect x="2" y="2" width="20" height="20" rx="5" ry="5"/><path d="M16 11.37A4 4 0 1112.63 8 4 4 0 0116 11.37z"/><line x1="17.5" y1="6.5" x2="17.51" y2="6.5"/>`,
  },
  {
    key: 'facebook',
    label: 'Facebook',
    href: SITE_CONFIG.social.facebook,
    icon: `<path d="M18 2h-3a5 5 0 00-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 011-1h3z"/>`,
  },
  {
    key: 'tiktok',
    label: 'TikTok',
    href: SITE_CONFIG.social.tiktok,
    icon: `<path d="M16 4a4 4 0 004 4v3a7 7 0 01-4-1.3V16a6 6 0 11-6-6v3a3 3 0 103 3V2h3a4 4 0 010 2z"/>`,
  },
]

const visibleSocials = socials.filter((s) => s.href && !s.href.startsWith('['))
---

<footer class="footer">
  <div class="footer-inner">
    <div class="footer-brand">
      <span class="footer-logo">{SITE_CONFIG.name}</span>
      <p class="footer-tagline">{SITE_CONFIG.tagline}</p>
      {visibleSocials.length > 0 && (
        <div class="footer-social" aria-label="Redes sociales">
          {visibleSocials.map((s) => (
            <a href={s.href} aria-label={s.label} target="_blank" rel="noopener noreferrer">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" set:html={s.icon} />
            </a>
          ))}
        </div>
      )}
    </div>

    <div class="footer-links">
      <div class="footer-col">
        <h4>Tienda</h4>
        <a href="/productos">Todos los productos</a>
        <a href="/productos?category=camisetas">Camisetas</a>
        <a href="/productos?category=pantalones">Pantalones</a>
        <a href="/productos?category=shorts">Shorts</a>
      </div>

      <div class="footer-col">
        <h4>Cuenta</h4>
        <a href="/auth/login">Iniciar sesión</a>
        <a href="/auth/register">Registrarse</a>
        <a href="/perfil">Mi perfil</a>
        <a href="/perfil/ordenes">Mis órdenes</a>
      </div>

      <div class="footer-col">
        <h4>Legal</h4>
        <a href="/legal/terminos-y-condiciones">Términos y condiciones</a>
        <a href="/legal/politica-de-privacidad">Política de privacidad</a>
        <a href="/legal/politica-de-devoluciones">Devoluciones y retracto</a>
      </div>

      <div class="footer-col">
        <h4>Ayuda</h4>
        <a href="/contacto">Contáctanos</a>
      </div>
    </div>
  </div>

  <div class="footer-bottom">
    <p>© {new Date().getFullYear()} {SITE_CONFIG.name}. Todos los derechos reservados.</p>
  </div>
</footer>

<style>
  .footer-social {
    display: flex;
    gap: 0.5rem;
    margin-top: 1rem;
  }

  .footer-social a {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 36px;
    height: 36px;
    border-radius: 50%;
    background: var(--color-gray-100);
    color: var(--color-gray-700);
    transition: all 150ms ease;
  }

  .footer-social a:hover {
    background: var(--color-black);
    color: var(--color-white);
    transform: translateY(-1px);
  }
</style>
