---
import Icon from './Icon.astro'
---

<header class="header">
  <div class="header-inner">

    <a href="/" class="logo" aria-label="Kaes - Inicio">KAES</a>

    <nav class="nav-desktop" aria-label="Navegación principal">
      <a href="/productos" class="nav-link">Colección</a>
      <a href="/productos?category=camisetas" class="nav-link">Camisetas</a>
      <a href="/productos?category=pantalones" class="nav-link">Pantalones</a>
      <a href="/productos?category=shorts" class="nav-link">Shorts</a>
    </nav>

    <div class="header-actions">
      <div id="auth-section-desktop" class="auth-desktop"></div>

      <button
        class="icon-btn cart-btn"
        id="cart-toggle-btn"
        type="button"
        aria-label="Abrir carrito"
      >
        <Icon name="cart" size={20} />
        <span class="cart-badge" id="cart-count" hidden>0</span>
      </button>

      <button
        class="icon-btn menu-btn"
        id="menu-toggle-btn"
        type="button"
        aria-label="Abrir menú"
        aria-expanded="false"
        aria-controls="mobile-drawer"
      >
        <Icon name="menu" size={22} />
      </button>
    </div>

  </div>
</header>

<div class="drawer-overlay" id="drawer-overlay" hidden></div>

<aside
  class="drawer"
  id="mobile-drawer"
  aria-label="Menú móvil"
  aria-hidden="true"
  inert
>
  <div class="drawer-header">
    <span class="drawer-logo">KAES</span>
    <button
      class="icon-btn"
      id="menu-close-btn"
      type="button"
      aria-label="Cerrar menú"
    >
      <Icon name="close" size={22} />
    </button>
  </div>

  <nav class="drawer-nav" aria-label="Navegación móvil">
    <a href="/productos" class="drawer-link">Colección</a>
    <a href="/productos?category=camisetas" class="drawer-link">Camisetas</a>
    <a href="/productos?category=pantalones" class="drawer-link">Pantalones</a>
    <a href="/productos?category=shorts" class="drawer-link">Shorts</a>
  </nav>

  <div class="drawer-divider"></div>

  <div id="auth-section-mobile" class="drawer-auth"></div>
</aside>

<script>
  import { cartCount } from '../../stores/cart.store.js'
  import { currentUser } from '../../stores/auth.store.js'
  import { api } from '../../lib/api.js'

  const badge = document.getElementById('cart-count')
  cartCount.subscribe((count) => {
    if (!badge) return
    if (count > 0) {
      badge.textContent = count > 99 ? '99+' : String(count)
      badge.hidden = false
    } else {
      badge.hidden = true
    }
  })

  const renderAuthDesktop = (user) => {
    const el = document.getElementById('auth-section-desktop')
    if (!el) return
    if (user) {
      const profileLink = user.role === 'ADMIN' ? '/admin' : '/perfil'
      const displayName = user.role === 'ADMIN' ? 'Admin' : (user.name?.split(' ')[0] || 'Perfil')
      el.innerHTML = `
        <a href="${profileLink}" class="nav-link">${displayName}</a>
        <button id="header-logout-desktop" class="icon-btn" type="button" aria-label="Cerrar sesión">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M9 21H5a2 2 0 01-2-2V5a2 2 0 012-2h4"/><polyline points="16 17 21 12 16 7"/><line x1="21" y1="12" x2="9" y2="12"/></svg>
        </button>
      `
    } else {
      el.innerHTML = `
        <a href="/auth/login" class="btn-header">Iniciar sesión</a>
        <a href="/auth/register" class="btn-header btn-header-primary">Crear cuenta</a>
      `
    }
  }

  const renderAuthMobile = (user) => {
    const el = document.getElementById('auth-section-mobile')
    if (!el) return
    if (user) {
      const profileLink = user.role === 'ADMIN' ? '/admin' : '/perfil'
      const displayName = user.role === 'ADMIN' ? 'Admin' : (user.name?.split(' ')[0] || 'Perfil')
      el.innerHTML = `
        <a href="${profileLink}" class="drawer-link drawer-link-strong">${displayName}</a>
        <button id="header-logout-mobile" class="drawer-link drawer-link-action" type="button">Cerrar sesión</button>
      `
    } else {
      el.innerHTML = `
        <a href="/auth/login" class="drawer-link drawer-link-strong">Iniciar sesión</a>
        <a href="/auth/register" class="drawer-link drawer-link-strong">Crear cuenta</a>
      `
    }
  }

  currentUser.subscribe((user) => {
    renderAuthDesktop(user)
    renderAuthMobile(user)
  })

  const handleLogout = async () => {
    const { clearAuth } = await import('../../stores/auth.store.js')
    clearAuth()
    try { await api.auth.logout() } catch { /* ignore */ }
    window.location.href = '/'
  }

  document.addEventListener('click', (e) => {
    const target = e.target
    if (target.closest && (target.closest('#header-logout-desktop') || target.closest('#header-logout-mobile'))) {
      handleLogout()
    }
  })

  const drawer = document.getElementById('mobile-drawer')
  const overlay = document.getElementById('drawer-overlay')
  const openBtn = document.getElementById('menu-toggle-btn')
  const closeBtn = document.getElementById('menu-close-btn')

  const openDrawer = () => {
    if (!drawer || !overlay || !openBtn) return
    drawer.removeAttribute('inert')
    drawer.setAttribute('aria-hidden', 'false')
    drawer.classList.add('is-open')
    overlay.hidden = false
    requestAnimationFrame(() => overlay.classList.add('is-visible'))
    openBtn.setAttribute('aria-expanded', 'true')
    document.body.style.overflow = 'hidden'
    const firstLink = drawer.querySelector('.drawer-link')
    if (firstLink) firstLink.focus()
  }

  const closeDrawer = () => {
    if (!drawer || !overlay || !openBtn) return
    drawer.classList.remove('is-open')
    drawer.setAttribute('aria-hidden', 'true')
    overlay.classList.remove('is-visible')
    setTimeout(() => {
      overlay.hidden = true
      drawer.setAttribute('inert', '')
    }, 220)
    openBtn.setAttribute('aria-expanded', 'false')
    document.body.style.overflow = ''
    openBtn.focus()
  }

  openBtn?.addEventListener('click', openDrawer)
  closeBtn?.addEventListener('click', closeDrawer)
  overlay?.addEventListener('click', closeDrawer)

  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && drawer?.classList.contains('is-open')) {
      closeDrawer()
    }
  })

  drawer?.querySelectorAll('a.drawer-link').forEach((a) => {
    a.addEventListener('click', closeDrawer)
  })

  document.getElementById('cart-toggle-btn')?.addEventListener('click', () => {
    window.location.href = '/carrito'
  })
</script>

<style>
  .header {
    position:        fixed;
    top:             0;
    left:            0;
    right:           0;
    z-index:         100;
    background:      rgba(255,255,255,0.92);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border-bottom:   1px solid rgba(0,0,0,0.06);
  }

  .header-inner {
    max-width:       var(--max-width);
    margin:          0 auto;
    height:          var(--header-height);
    display:         flex;
    align-items:     center;
    justify-content: space-between;
    padding:         0 var(--container-padding);
    gap:             1rem;
  }

  .logo {
    font-size:      1rem;
    font-weight:    700;
    letter-spacing: 0.2em;
    color:          var(--color-black);
    text-transform: uppercase;
  }

  .nav-desktop {
    display:  none;
    gap:      2rem;
    position: absolute;
    left:     50%;
    transform: translateX(-50%);
  }

  .nav-link {
    font-size:      0.9rem;
    font-weight:    500;
    letter-spacing: 0.03em;
    color:          var(--color-gray-600);
    transition:     color 150ms ease;
  }
  .nav-link:hover { color: var(--color-black); }

  .header-actions {
    display:     flex;
    align-items: center;
    gap:         0.5rem;
  }

  .auth-desktop {
    display:     none;
    align-items: center;
    gap:         1rem;
  }

  .btn-header {
    display:         inline-flex;
    align-items:     center;
    font-size:       0.875rem;
    font-weight:     500;
    padding:         0.5rem 1rem;
    border:          1px solid var(--color-black);
    border-radius:   var(--radius-md);
    color:           var(--color-black);
    transition:      all 150ms ease;
    white-space:     nowrap;
  }
  .btn-header:hover {
    background: var(--color-black);
    color:      var(--color-white);
  }
  .btn-header-primary {
    background: var(--color-black);
    color:      var(--color-white);
  }
  .btn-header-primary:hover {
    background: var(--color-gray-800);
  }

  .icon-btn {
    position:    relative;
    display:     flex;
    align-items: center;
    color:       var(--color-black);
    padding:     0.4rem;
    border-radius: var(--radius-md);
    transition:  background 150ms ease;
  }
  .icon-btn:hover { background: var(--color-gray-100); }

  .menu-btn { display: flex; }

  .cart-badge {
    position:        absolute;
    top:             2px;
    right:           2px;
    background:      var(--color-black);
    color:           var(--color-white);
    font-size:       0.6rem;
    font-weight:     600;
    min-width:       16px;
    height:          16px;
    padding:         0 4px;
    border-radius:   var(--radius-full);
    display:         flex;
    align-items:     center;
    justify-content: center;
    line-height:     1;
  }

  .drawer-overlay {
    position:   fixed;
    inset:      0;
    background: rgba(0,0,0,0.4);
    opacity:    0;
    transition: opacity 200ms ease;
    z-index:    110;
  }
  .drawer-overlay.is-visible { opacity: 1; }

  .drawer {
    position:      fixed;
    top:           0;
    right:         0;
    bottom:        0;
    width:         min(86vw, 360px);
    background:    var(--color-white);
    z-index:       120;
    transform:     translateX(100%);
    transition:    transform 220ms cubic-bezier(0.16, 1, 0.3, 1);
    display:       flex;
    flex-direction: column;
    padding:       1.25rem;
    box-shadow:    -8px 0 32px rgba(0,0,0,0.08);
  }
  .drawer.is-open { transform: translateX(0); }

  .drawer-header {
    display:         flex;
    align-items:     center;
    justify-content: space-between;
    margin-bottom:   1.5rem;
  }
  .drawer-logo {
    font-weight:    700;
    letter-spacing: 0.2em;
    font-size:      1rem;
  }

  .drawer-nav {
    display:        flex;
    flex-direction: column;
    gap:            0.25rem;
  }
  .drawer-link {
    display:         block;
    padding:         0.85rem 0.5rem;
    border-radius:   var(--radius-md);
    color:           var(--color-gray-800);
    font-size:       1rem;
    font-weight:     500;
    transition:      background 150ms ease;
  }
  .drawer-link:hover { background: var(--color-gray-100); }
  .drawer-link-strong { font-weight: 600; color: var(--color-black); }
  .drawer-link-action { color: var(--color-gray-500); cursor: pointer; background: none; border: none; text-align: left; font-family: inherit; }

  .drawer-divider {
    height:     1px;
    background: var(--color-gray-200);
    margin:     1rem 0;
  }

  .drawer-auth {
    margin-top: auto;
    display:        flex;
    flex-direction: column;
    gap:            0.25rem;
    padding-top:    1rem;
    border-top:     1px solid var(--color-gray-200);
  }

  @media (min-width: 1024px) {
    .nav-desktop { display: flex; }
    .auth-desktop { display: flex; }
    .menu-btn { display: none; }
  }

  @media (max-width: 480px) {
    .logo { font-size: 0.85rem; }
  }

  @media (prefers-reduced-motion: reduce) {
    .drawer { transition: none; }
    .drawer-overlay { transition: none; }
  }
</style>