---
// Categorías de la home. HTML estático; la entrada escalonada la hace
// src/scripts/reveal.js (antes StaggerGrid de framer-motion).
const categories = [
  {
    name: 'Camisetas',
    slug: 'camisetas',
    paths: [
      '<path d="M16 4l-4 4-4-4H4l4 6v10h8V10l4-6h-4z" />',
      '<path d="M10 4.2c0 1.4.9 2.3 2 2.3s2-.9 2-2.3" />',
    ],
  },
  {
    name: 'Pantalones',
    slug: 'pantalones',
    paths: [
      '<path d="M4 4h16v2l-2 14h-4l-1-7h-2l-1 7H6L4 6V4z" />',
      '<line x1="4" y1="6" x2="20" y2="6" />',
    ],
  },
  {
    name: 'Shorts',
    slug: 'shorts',
    paths: [
      '<path d="M4 4h16v2l-2 8h-4l-1-3h-2l-1 3H6L4 6V4z" />',
      '<line x1="4" y1="6" x2="20" y2="6" />',
    ],
  },
  {
    name: 'Accesorios',
    slug: 'accesorios',
    paths: [
      '<path d="M5 9h14l-1 11H6L5 9z" />',
      '<path d="M8 9V7a4 4 0 018 0v2" />',
      '<circle cx="12" cy="14.5" r="0.9" fill="currentColor" />',
    ],
  },
]
---

<section class="section categories-section" aria-label="Categorías">
  <div class="container">
    <div class="categories-grid">
      {categories.map((cat, i) => (
        <div data-reveal style={`--reveal-i: ${i}; --reveal-y: 24px`}>
          <a
            href={`/productos?category=${cat.slug}`}
            class="category-card"
            aria-label={`Ver categoría ${cat.name}`}
          >
            <div class="category-icon">
              <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={cat.paths.join('')} />
            </div>
            <span class="category-name">{cat.name}</span>
          </a>
        </div>
      ))}
    </div>
  </div>
</section>

<script>
  import '../../scripts/reveal.js'
</script>
