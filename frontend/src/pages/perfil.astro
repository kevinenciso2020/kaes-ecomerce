---
import ShopLayout from '../layouts/ShopLayout.astro'
---

<ShopLayout title="Mi perfil">
  <div class="perfil-page container" id="perfil-content" hidden>

    <h1 class="page-title">Mi cuenta</h1>

    <div class="perfil-grid">
      <div class="perfil-card">
        <h2 class="card-title">Información personal</h2>
        <div id="user-info" class="user-info"></div>
        <button type="button" class="btn btn-outline" id="logout-btn">Cerrar sesión</button>
      </div>

      <div class="perfil-card">
        <h2 class="card-title">Mis órdenes</h2>
        <div id="orders-list">
          <p class="loading-text">Cargando...</p>
        </div>
      </div>
    </div>

  </div>

  <div id="perfil-empty" hidden class="perfil-empty">
    <p>Debes iniciar sesión para ver tu perfil</p>
    <a href="/auth/login" class="btn btn-primary">Iniciar sesión</a>
  </div>
</ShopLayout>

<script>
  import { currentUser, clearAuth } from '../stores/auth.store.js'
  import { api } from '../lib/api.js'
  import { escapeHtml } from '../lib/sanitize.js'

  const user = currentUser.get()

  if (!user) {
    const el = document.getElementById('perfil-empty')
    if (el) el.hidden = false
  } else {
    const el = document.getElementById('perfil-content')
    if (el) el.hidden = false

    const infoEl = document.getElementById('user-info')
    if (infoEl) {
      infoEl.innerHTML = `
        <div class="info-row"><span class="info-label">Nombre</span><span>${escapeHtml(user.name)}</span></div>
        <div class="info-row"><span class="info-label">Email</span><span>${escapeHtml(user.email)}</span></div>
        <div class="info-row"><span class="info-label">Rol</span><span>${user.role === 'ADMIN' ? 'Administrador' : 'Cliente'}</span></div>
      `
    }

    api.orders.list().then((orders) => {
      const ordersEl = document.getElementById('orders-list')
      if (!ordersEl) return
      if (!orders.length) {
        ordersEl.innerHTML = '<p class="empty-text">No tienes órdenes aún</p>'
        return
      }
      ordersEl.innerHTML = orders.map(order => `
        <a href="/perfil/ordenes/${order.id}" class="order-row">
          <span class="order-id">#${order.id.slice(-6).toUpperCase()}</span>
          <span class="order-date">${new Date(order.createdAt).toLocaleDateString('es-CO')}</span>
          <span class="badge badge-gray">${escapeHtml(order.status)}</span>
          <span class="order-total">$${Number(order.total).toLocaleString('es-CO')}</span>
        </a>
      `).join('')
    }).catch(() => {
      const ordersEl = document.getElementById('orders-list')
      if (ordersEl) ordersEl.innerHTML = '<p class="empty-text">Error cargando órdenes</p>'
    })

    document.getElementById('logout-btn')?.addEventListener('click', () => {
      clearAuth()
      api.auth.logout().catch(() => {})
      window.location.href = '/'
    })
  }
</script>

<style>
  .perfil-page {
    padding-top:    calc(var(--header-height) + 1.5rem);
    padding-bottom: 3rem;
  }

  .page-title {
    font-family:   var(--font-serif);
    font-size:     1.6rem;
    font-weight:   600;
    color:         var(--color-black);
    margin-bottom: 1.5rem;
    padding-bottom: 1.25rem;
    border-bottom: 1px solid var(--color-gray-200);
  }

  .perfil-grid {
    display:               grid;
    grid-template-columns: 1fr;
    gap:                   1.25rem;
    align-items:           start;
  }

  .perfil-card {
    background:     var(--color-white);
    border:         1px solid var(--color-gray-200);
    border-radius:  var(--radius-lg);
    padding:        1.25rem;
    display:        flex;
    flex-direction: column;
    gap:            0.85rem;
  }

  .card-title {
    font-size:      0.7rem;
    font-weight:    600;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color:          var(--color-gray-500);
    margin-bottom:  0.5rem;
  }

  .info-row {
    display:         flex;
    justify-content: space-between;
    align-items:     center;
    padding:         0.5rem 0;
    border-bottom:   1px solid var(--color-gray-100);
    font-size:       0.875rem;
    gap:             0.5rem;
  }

  .info-label { color: var(--color-gray-500); font-weight: 500; }

  .loading-text, .empty-text {
    font-size: 0.875rem;
    color:     var(--color-gray-500);
    padding:   1rem 0;
  }

  .order-row {
    display:         flex;
    justify-content: space-between;
    align-items:     center;
    padding:         0.75rem 0;
    border-bottom:   1px solid var(--color-gray-100);
    font-size:       0.875rem;
    gap:             0.5rem;
    text-decoration: none;
    color:           inherit;
    transition:      background-color 0.2s;
    flex-wrap:       wrap;
  }

  .order-row:hover { background-color: var(--color-gray-50); }

  .order-id    { font-weight: 600; color: var(--color-black); font-size: 0.8rem; }
  .order-date  { color: var(--color-gray-500); font-size: 0.8rem; }
  .order-total { font-weight: 600; color: var(--color-black); }

  .perfil-empty {
    min-height:      70vh;
    display:         flex;
    flex-direction:  column;
    align-items:     center;
    justify-content: center;
    gap:             1rem;
    color:           var(--color-gray-500);
    text-align:      center;
    padding:         1rem;
  }

  @media (min-width: 768px) {
    .perfil-page { padding-top: calc(var(--header-height) + 2rem); padding-bottom: 4rem; }
    .perfil-grid { grid-template-columns: 280px 1fr; gap: 2rem; }
    .perfil-card { padding: 1.5rem; gap: 1rem; }
    .page-title  { font-size: 2rem; margin-bottom: 2rem; }
  }

  @media (min-width: 1024px) {
    .perfil-grid { grid-template-columns: 300px 1fr; }
  }

  @media (prefers-reduced-motion: reduce) {
    .order-row { transition: none; }
  }
</style>