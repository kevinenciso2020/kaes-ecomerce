---
// Ruta antigua: redirige a la página única de resultado conservando los
// parámetros que agregan las pasarelas (orderId, id, payment_id, external_reference…).
const target = new URL('/checkout/resultado', Astro.url)
Astro.url.searchParams.forEach((value, key) => target.searchParams.set(key, value))
return Astro.redirect(`${target.pathname}${target.search}`, 302)
