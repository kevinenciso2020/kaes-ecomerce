---
import ShopLayout from '../layouts/ShopLayout.astro'
import Icon from '../components/ui/Icon.astro'
---

<ShopLayout title="Mi carrito">
  <div class="cart-page container">

    <h1 class="page-title">Mi carrito</h1>

    <div id="cart-empty" hidden class="cart-empty">
      <div class="cart-empty-icon">
        <Icon name="cart" size={48} strokeWidth={1} />
      </div>
      <p>Tu carrito está vacío</p>
      <a href="/productos" class="btn btn-primary">Ver productos</a>
    </div>

    <div id="cart-content" hidden class="cart-layout">

      <div class="cart-items" id="cart-items-list" aria-live="polite"></div>

      <aside class="cart-summary" aria-label="Resumen del pedido">
        <h2 class="summary-title">Resumen del pedido</h2>

        <div class="summary-rows">
          <div class="summary-row">
            <span>Subtotal</span>
            <span id="summary-subtotal">$0</span>
          </div>
          <div class="summary-row">
            <span>Envío</span>
            <span class="shipping-free">Gratis</span>
          </div>
        </div>

        <div class="coupon-group">
          <label for="coupon-input" class="sr-only">Código de cupón</label>
          <input
            type="text"
            id="coupon-input"
            class="form-input"
            placeholder="Código de cupón"
            autocomplete="off"
          />
          <button class="btn btn-outline" id="apply-coupon-btn" type="button">Aplicar</button>
        </div>
        <div id="coupon-message" hidden class="coupon-message"></div>

        <div class="summary-row total-row">
          <span>Total</span>
          <span id="summary-total">$0</span>
        </div>

        <button class="btn btn-primary btn-full" id="checkout-btn" type="button">
          Proceder al pago
        </button>

        <a href="/productos" class="continue-shopping">
          <Icon name="arrowLeft" size={14} />
          Continuar comprando
        </a>
      </aside>

    </div>

  </div>
</ShopLayout>

<script>
  import { cartItems, cartTotal, removeFromCart, updateQuantity } from '../stores/cart.store.js'
  import { api } from '../lib/api.js'
  import { sanitizeCartItem, escapeHtml } from '../lib/sanitize.js'

  const renderCart = (items) => {
    const sanitized = items.map(sanitizeCartItem)
    const total    = cartTotal.get()
    const isEmpty  = items.length === 0
    const emptyEl  = document.getElementById('cart-empty')
    const contentEl = document.getElementById('cart-content')

    if (!emptyEl || !contentEl) return

    emptyEl.hidden   = !isEmpty
    contentEl.hidden = isEmpty

    if (isEmpty) return

    const listEl = document.getElementById('cart-items-list')
    if (listEl) {
      listEl.innerHTML = sanitized.map((item) => `
        <article class="cart-item" data-id="${escapeHtml(item.id)}" data-size="${escapeHtml(item.size || '')}" data-color="${escapeHtml(item.color || '')}">
          <div class="item-image">
            ${item.image
              ? `<img src="${escapeHtml(item.image)}" alt="${escapeHtml(item.name)}" loading="lazy" />`
              : `<div class="item-image-placeholder"><svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M21 16V8a2 2 0 00-1-1.73l-7-4a2 2 0 00-2 0l-7 4A2 2 0 003 8v8a2 2 0 001 1.73l7 4a2 2 0 002 0l7-4A2 2 0 0021 16z"/><polyline points="3.27 6.96 12 12.01 20.73 6.96"/><line x1="12" y1="22.08" x2="12" y2="12"/></svg></div>`
            }
          </div>
          <div class="item-details">
            <h3 class="item-name">${escapeHtml(item.name)}</h3>
            <div class="item-variants">
              ${item.size  ? `<span class="variant-tag">Talla: ${escapeHtml(item.size)}</span>`  : ''}
              ${item.color ? `<span class="variant-tag">Color: ${escapeHtml(item.color)}</span>` : ''}
            </div>
            <p class="item-price">$${Number(item.price).toLocaleString('es-CO')}</p>
          </div>
          <div class="item-controls">
            <div class="quantity-selector" role="group" aria-label="Cantidad de ${escapeHtml(item.name)}">
              <button class="qty-btn" type="button" data-action="decrease" aria-label="Disminuir">−</button>
              <span aria-live="polite">${item.quantity}</span>
              <button class="qty-btn" type="button" data-action="increase" aria-label="Aumentar">+</button>
            </div>
            <p class="item-subtotal">$${Number(item.price * item.quantity).toLocaleString('es-CO')}</p>
            <button class="remove-btn" type="button" data-action="remove" aria-label="Eliminar ${escapeHtml(item.name)}">Eliminar</button>
          </div>
        </article>
      `).join('')
    }

    const formatted = '$' + Number(total).toLocaleString('es-CO')
    const subtotalEl = document.getElementById('summary-subtotal')
    const totalEl    = document.getElementById('summary-total')
    if (subtotalEl) subtotalEl.textContent = formatted
    if (totalEl)    totalEl.textContent    = formatted
  }

  cartItems.subscribe(renderCart)

  const listEl = document.getElementById('cart-items-list')
  listEl?.addEventListener('click', (e) => {
    const target = e.target
    const btn = target.closest('[data-action]')
    if (!btn) return
    const item = btn.closest('.cart-item')
    if (!item) return

    const id    = item.dataset.id || ''
    const size  = item.dataset.size  === '' ? null : (item.dataset.size  || null)
    const color = item.dataset.color === '' ? null : (item.dataset.color || null)
    const items = cartItems.get()
    const found = items.find((i) => i.id === id && (i.size || null) === size && (i.color || null) === color)

    const action = btn.dataset.action
    if (!found || !action) return

    if (action === 'increase') {
      updateQuantity(id, size, color, found.quantity + 1)
    } else if (action === 'decrease') {
      updateQuantity(id, size, color, found.quantity - 1)
    } else if (action === 'remove') {
      removeFromCart(id, size, color)
    }
  })

  const applyBtn = document.getElementById('apply-coupon-btn')
  const couponInput = document.getElementById('coupon-input')
  const couponMsg = document.getElementById('coupon-message')

  const showCouponMessage = (text, type) => {
    if (!couponMsg) return
    couponMsg.textContent = text
    couponMsg.className = `coupon-message coupon-${type}`
    couponMsg.hidden = false
  }

  applyBtn?.addEventListener('click', async () => {
    const code = couponInput?.value.trim() || ''
    if (!code) {
      showCouponMessage('Ingresa un código', 'error')
      return
    }

    applyBtn.disabled = true
    const prevText = applyBtn.textContent
    applyBtn.textContent = 'Validando...'

    try {
      const subtotal = cartTotal.get()
      const coupon = await api.coupons.validate(code, subtotal)

      localStorage.setItem('couponCode', coupon.code)
      localStorage.setItem('couponDiscount', JSON.stringify(coupon))

      const discountFormatted = coupon.type === 'PERCENTAGE'
        ? `${coupon.value}%`
        : `$${Number(coupon.discount).toLocaleString('es-CO')}`

      showCouponMessage(`Cupón aplicado: -${discountFormatted}`, 'success')

      const newTotal = subtotal - coupon.discount
      const totalEl = document.getElementById('summary-total')
      if (totalEl) {
        totalEl.textContent = '$' + Number(Math.max(0, newTotal)).toLocaleString('es-CO')
      }
    } catch (err) {
      localStorage.removeItem('couponCode')
      localStorage.removeItem('couponDiscount')
      showCouponMessage(err.message || 'Cupón no válido', 'error')
    } finally {
      applyBtn.disabled = false
      applyBtn.textContent = prevText || 'Aplicar'
    }
  })

  document.getElementById('checkout-btn')?.addEventListener('click', () => {
    const user = localStorage.getItem('user')
    if (!user) {
      window.location.href = '/auth/login?redirect=/carrito'
      return
    }
    window.location.href = '/checkout'
  })
</script>

<style>
  .sr-only {
    position:      absolute;
    width:         1px;
    height:        1px;
    padding:       0;
    margin:        -1px;
    overflow:      hidden;
    clip:          rect(0, 0, 0, 0);
    white-space:   nowrap;
    border:        0;
  }

  .cart-page {
    padding-top:    calc(var(--header-height) + 1.5rem);
    padding-bottom: 3rem;
    max-width:      var(--max-width);
    margin:         0 auto;
  }

  .page-title {
    font-family:   var(--font-serif);
    font-size:     1.6rem;
    font-weight:   600;
    color:         var(--color-black);
    margin-bottom: 1.5rem;
  }

  .cart-empty {
    flex-direction:  column;
    align-items:     center;
    justify-content: center;
    gap:             1rem;
    padding:         4rem 1rem;
    text-align:      center;
    color:           var(--color-gray-500);
    font-size:       1rem;
  }
  .cart-empty-icon {
    width:          80px;
    height:         80px;
    border-radius:  50%;
    background:     var(--color-gray-50);
    color:          var(--color-gray-400);
    display:        flex;
    align-items:    center;
    justify-content: center;
  }

  .cart-layout {
    display:               grid;
    grid-template-columns: 1fr;
    gap:                   2rem;
    align-items:           start;
  }

  .cart-items {
    display:        flex;
    flex-direction: column;
    gap:            0.75rem;
  }

  .cart-item {
    display:       grid;
    grid-template-columns: 80px 1fr;
    gap:           0.85rem;
    padding:       0.85rem;
    border:        1.5px solid var(--color-gray-200);
    border-radius: var(--radius-lg);
    background:    var(--color-white);
  }

  .item-image {
    width:         80px;
    height:        105px;
    border-radius: var(--radius-md);
    overflow:      hidden;
    background:    var(--color-gray-100);
  }
  .item-image img { width: 100%; height: 100%; object-fit: cover; }
  .item-image-placeholder {
    width:        100%;
    height:       100%;
    display:      flex;
    align-items:  center;
    justify-content: center;
    color:        var(--color-gray-400);
  }

  .item-details { min-width: 0; }
  .item-name {
    font-size:     0.9rem;
    font-weight:   600;
    color:         var(--color-black);
    margin-bottom: 0.4rem;
    line-height:   1.3;
  }
  .item-variants { display: flex; gap: 0.4rem; margin-bottom: 0.4rem; flex-wrap: wrap; }
  .variant-tag {
    font-size:     0.7rem;
    padding:       2px 8px;
    background:    var(--color-gray-100);
    border-radius: var(--radius-full);
    color:         var(--color-gray-600);
  }
  .item-price { font-size: 0.85rem; color: var(--color-gray-500); margin: 0; }

  .item-controls {
    grid-column: 1 / -1;
    display:        flex;
    flex-direction: row;
    align-items:     center;
    justify-content: space-between;
    gap:             0.85rem;
    padding-top:     0.5rem;
    border-top:      1px dashed var(--color-gray-200);
  }

  .quantity-selector {
    display:       flex;
    align-items:   center;
    gap:           0.5rem;
    border:        1.5px solid var(--color-gray-200);
    border-radius: var(--radius-md);
    padding:       0.25rem 0.6rem;
  }
  .qty-btn {
    font-size:  1.1rem;
    color:      var(--color-gray-600);
    width:      24px;
    text-align: center;
    transition: color var(--transition);
    background: none;
    border:     none;
    cursor:     pointer;
  }
  .qty-btn:hover { color: var(--color-black); }
  .quantity-selector span { font-weight: 600; min-width: 20px; text-align: center; font-size: 0.9rem; }

  .item-subtotal {
    font-size:   1rem;
    font-weight: 600;
    color:       var(--color-black);
  }

  .remove-btn {
    font-size:      0.8rem;
    color:          var(--color-gray-500);
    transition:     color var(--transition);
    background:     none;
    border:         none;
    cursor:         pointer;
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .remove-btn:hover { color: var(--color-danger); }

  .cart-summary {
    background:    var(--color-white);
    border:        1.5px solid var(--color-gray-200);
    border-radius: var(--radius-lg);
    padding:       1.25rem;
  }

  .summary-title {
    font-size:     1.1rem;
    font-weight:   600;
    color:         var(--color-black);
    margin-bottom: 1.25rem;
    padding-bottom: 0.85rem;
    border-bottom: 1.5px solid var(--color-gray-200);
  }

  .summary-rows { display: flex; flex-direction: column; gap: 0.6rem; margin-bottom: 1.25rem; }
  .summary-row {
    display:         flex;
    justify-content: space-between;
    font-size:       0.9rem;
    color:           var(--color-gray-600);
  }
  .shipping-free { color: var(--color-success); font-weight: 500; }

  .total-row {
    font-size:    1.1rem;
    font-weight:  600;
    color:        var(--color-black);
    padding-top:  0.85rem;
    border-top:   1.5px solid var(--color-gray-200);
    margin-top:   0.85rem;
    margin-bottom: 1.25rem;
  }

  .coupon-group { display: flex; gap: 0.5rem; margin-bottom: 0.5rem; }
  .coupon-group .form-input { flex: 1; min-width: 0; }

  .coupon-message {
    padding:       0.5rem 0.75rem;
    border-radius: var(--radius-md);
    font-size:     0.8rem;
    margin-bottom: 0.85rem;
  }
  .coupon-success { background: #dcfce7; color: #166534; }
  .coupon-error   { background: #fee2e2; color: #991b1b; }

  .btn-full { width: 100%; }

  .continue-shopping {
    display:    flex;
    align-items: center;
    justify-content: center;
    gap:        0.4rem;
    margin-top: 0.85rem;
    font-size:  0.875rem;
    color:      var(--color-gray-500);
    transition: color var(--transition);
  }
  .continue-shopping:hover { color: var(--color-black); }

  @media (min-width: 768px) {
    .cart-page { padding-top: calc(var(--header-height) + 2rem); padding-bottom: 4rem; }
    .cart-layout { grid-template-columns: 1fr 360px; gap: 2rem; }
    .cart-item { grid-template-columns: 100px 1fr auto; padding: 1rem; gap: 1rem; }
    .item-image { width: 100px; height: 130px; }
    .item-controls {
      grid-column: auto;
      flex-direction: column;
      align-items:    flex-end;
      border-top:     none;
      padding-top:    0;
    }
  }

  @media (min-width: 1024px) {
    .cart-layout { grid-template-columns: 1fr 380px; gap: 2.5rem; }
  }

  @media (prefers-reduced-motion: reduce) {
    .cart-item,
    .qty-btn,
    .remove-btn,
    .continue-shopping { transition: none; }
  }
</style>