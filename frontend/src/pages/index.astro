---
import ShopLayout from '../layouts/ShopLayout.astro'
import HeroSection from '../components/sections/HeroSection.astro'
import CategoriesSection from '../components/sections/CategoriesSection.astro'
import ProductCarousel from '../components/sections/ProductCarousel.astro'
import FeaturedProducts from '../components/sections/FeaturedProducts.astro'
import CtaBanner from '../components/sections/CtaBanner.astro'
import '../styles/index.css'
import { api } from '../lib/api.js'
import { isAvailable } from '../lib/carousel.js'

let featuredProducts = []
let hasError = false

// Carrusel: todo el catálogo activo (la API pagina de a 48), solo lo que tiene
// stock. Si falla, el carrusel no se muestra y el resto de la página sigue igual.
const MAX_PAGINAS_CARRUSEL = 5
const loadCarouselProducts = async () => {
  const all = []
  for (let page = 1; page <= MAX_PAGINAS_CARRUSEL; page++) {
    const data = await api.products.list({ limit: 48, page })
    all.push(...(Array.isArray(data.products) ? data.products : []))
    if (page >= (data.pagination?.totalPages ?? 1)) break
  }
  // Solo los campos que pinta la tarjeta: las props de la isla viajan en el HTML.
  return all.filter(isAvailable).map((p) => ({
    slug:       p.slug,
    name:       p.name,
    price:      p.price,
    finalPrice: p.finalPrice,
    stock:      p.stock,
    category:   p.category ? { name: p.category.name, slug: p.category.slug } : null,
    images:     p.images?.[0]?.url ? [{ url: p.images[0].url }] : [],
    variants:   (p.variants || []).map((v) => ({ size: v.size, color: v.color, stock: v.stock })),
  }))
}

const [featuredResult, carouselResult] = await Promise.allSettled([
  api.products.list({ featured: true, limit: 8 }),
  loadCarouselProducts(),
])

if (featuredResult.status === 'fulfilled') {
  featuredProducts = Array.isArray(featuredResult.value.products) ? featuredResult.value.products : []
} else {
  console.error('Error loading products:', featuredResult.reason)
  hasError = true
}

let carouselProducts = []
if (carouselResult.status === 'fulfilled') {
  carouselProducts = carouselResult.value
} else {
  console.error('Error loading carousel products:', carouselResult.reason)
}

// Catálogo cacheable en el borde (src/lib/page-cache.js): reduce carga al API
// y mejora TTFB.
Astro.response.headers.set('Cache-Control', 'public, s-maxage=60, stale-while-revalidate=300')
---

<ShopLayout title="Inicio" description="Prendas atemporales para quienes se atreven a definir su propio estilo.">
  <HeroSection />
  <ProductCarousel products={carouselProducts} />
  <CategoriesSection />
  <FeaturedProducts products={featuredProducts} loading={hasError && featuredProducts.length === 0} />
  <CtaBanner />
</ShopLayout>