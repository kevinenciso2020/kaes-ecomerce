---
import ShopLayout from '../../layouts/ShopLayout.astro'
---

<ShopLayout title="Restablecer contraseña">
  <div class="auth-page">
    <div class="auth-card">

      <div id="state-form" class="auth-state">
        <div class="auth-header">
          <h1 class="auth-title">Restablecer contraseña</h1>
          <p class="auth-subtitle">
            Ingresa el código de 6 dígitos que te enviamos y elige una nueva contraseña.
          </p>
        </div>

        <div id="auth-error" class="auth-error" role="alert" hidden></div>

        <div class="auth-form">
          <div class="form-group">
            <label class="form-label" for="email">Correo electrónico</label>
            <input
              type="email"
              id="email"
              class="form-input"
              placeholder="tu@email.com"
              autocomplete="email"
              inputmode="email"
              readonly
            />
          </div>

          <div class="form-group">
            <label class="form-label" for="code">Código de verificación</label>
            <input
              type="text"
              id="code"
              class="form-input code-input"
              placeholder="123456"
              inputmode="numeric"
              autocomplete="one-time-code"
              maxlength="6"
              pattern="\d{6}"
            />
          </div>

          <div class="form-group">
            <label class="form-label" for="password">Nueva contraseña</label>
            <input
              type="password"
              id="password"
              class="form-input"
              placeholder="Mínimo 6 caracteres"
              autocomplete="new-password"
              minlength="6"
            />
          </div>

          <div class="form-group">
            <label class="form-label" for="confirm-password">Confirmar contraseña</label>
            <input
              type="password"
              id="confirm-password"
              class="form-input"
              placeholder="Repite la contraseña"
              autocomplete="new-password"
              minlength="6"
            />
          </div>

          <button type="button" class="btn btn-primary btn-full" id="submit-btn">
            Cambiar contraseña
          </button>
        </div>

        <div class="auth-footer">
          <p>
            ¿No recibiste el código?
            <a href="#" id="resend-link">Reenviar</a>
          </p>
          <p><a href="/auth/login">← Volver a iniciar sesión</a></p>
        </div>
      </div>

      <div id="state-success" class="auth-state" hidden>
        <div class="state-icon state-icon-success" aria-hidden="true">✓</div>
        <h1 class="auth-title">¡Contraseña cambiada!</h1>
        <p class="auth-subtitle">
          Tu contraseña fue actualizada correctamente. Por seguridad, cerramos todas tus sesiones activas.
        </p>
        <a href="/auth/login" class="btn btn-primary btn-full">Iniciar sesión</a>
      </div>

    </div>
  </div>
</ShopLayout>

<script>
  import { api, ApiError } from '../../lib/api.js'

  const formState   = document.getElementById('state-form')
  const successState = document.getElementById('state-success')

  const emailInput   = document.getElementById('email')
  const codeInput    = document.getElementById('code')
  const passwordInput = document.getElementById('password')
  const confirmInput = document.getElementById('confirm-password')
  const submitBtn    = document.getElementById('submit-btn')
  const errorDiv     = document.getElementById('auth-error')
  const resendLink   = document.getElementById('resend-link')

  const params = new URLSearchParams(window.location.search)
  const initialEmail = params.get('email') || ''
  if (emailInput && initialEmail) emailInput.value = initialEmail

  const showError = (msg) => {
    if (!errorDiv) return
    errorDiv.textContent = msg
    errorDiv.hidden = false
    if (typeof errorDiv.scrollIntoView === 'function') {
      errorDiv.scrollIntoView({ behavior: 'smooth', block: 'center' })
    }
  }

  const setLoading = (loading) => {
    if (!submitBtn) return
    submitBtn.disabled    = loading
    submitBtn.textContent = loading ? 'Cambiando...' : 'Cambiar contraseña'
  }

  // Sólo dígitos en el input de código
  codeInput?.addEventListener('input', () => {
    codeInput.value = codeInput.value.replace(/\D/g, '').slice(0, 6)
  })

  submitBtn?.addEventListener('click', async () => {
    if (!errorDiv) return
    errorDiv.hidden = true

    const email    = emailInput.value.trim()
    const code     = codeInput.value.trim()
    const password = passwordInput.value
    const confirm  = confirmInput.value

    if (!email || !code) {
      showError('Por favor completa el correo y el código')
      return
    }
    if (code.length !== 6) {
      showError('El código debe tener exactamente 6 dígitos')
      return
    }
    if (password.length < 6) {
      showError('La contraseña debe tener al menos 6 caracteres')
      return
    }
    if (password !== confirm) {
      showError('Las contraseñas no coinciden')
      return
    }

    setLoading(true)

    try {
      await api.auth.resetPassword({ email, code, password, confirmPassword: confirm })

      if (formState)    formState.hidden    = true
      if (successState) successState.hidden = false
    } catch (err) {
      let msg = err?.message || 'No se pudo cambiar la contraseña'
      if (err instanceof ApiError) {
        if (err.status === 429) {
          msg = 'Demasiados intentos. Solicita un nuevo código.'
        } else if (err.status === 400) {
          msg = err.message || 'Código inválido o expirado'
        }
      }
      showError(msg)
    } finally {
      setLoading(false)
    }
  })

  resendLink?.addEventListener('click', async (e) => {
    e.preventDefault()
    const email = emailInput.value.trim()
    if (!email) return

    resendLink.textContent = 'Enviando...'
    try {
      await api.auth.forgotPassword(email)
      resendLink.textContent = '¡Código reenviado!'
      setTimeout(() => { resendLink.textContent = 'Reenviar' }, 3000)
    } catch (err) {
      if (err instanceof ApiError && err.status === 429) {
        showError('Has pedido demasiados códigos. Espera un momento.')
      } else {
        showError(err?.message || 'No se pudo reenviar el código')
      }
      resendLink.textContent = 'Reenviar'
    }
  })

  // Auto-focus al campo de código si ya hay email
  if (emailInput?.value && codeInput) {
    codeInput.focus()
  }
</script>

<style>
  .auth-page {
    min-height:  100dvh;
    display:     flex;
    align-items: center;
    justify-content: center;
    padding:     calc(var(--header-height) + 1rem) 1rem 2rem;
    background:  var(--color-gray-50);
  }

  .auth-card {
    width:         100%;
    max-width:     460px;
    background:    var(--color-white);
    border-radius: var(--radius-lg);
    border:        1.5px solid var(--color-gray-200);
    padding:       1.5rem;
    box-shadow:    var(--shadow-sm);
  }

  .auth-state {
    display:        flex;
    flex-direction: column;
    gap:            0.85rem;
  }

  .auth-header { text-align: center; margin-bottom: 1rem; }

  .auth-title {
    font-family:   var(--font-serif);
    font-size:     1.6rem;
    font-weight:   600;
    color:         var(--color-black);
    margin:        0 0 0.4rem;
    text-align:    center;
  }

  .auth-subtitle {
    font-size:  0.9rem;
    color:      var(--color-gray-600);
    margin:     0;
    text-align: center;
  }

  .state-icon {
    width:           56px;
    height:          56px;
    border-radius:   50%;
    display:         flex;
    align-items:     center;
    justify-content: center;
    font-size:       1.6rem;
    font-weight:     700;
    margin:          0 auto 0.25rem;
  }
  .state-icon-success { background: #dcfce7; color: #166534; }

  .auth-error {
    background:    #fee2e2;
    color:         #991b1b;
    padding:       0.75rem 1rem;
    border-radius: var(--radius-md);
    font-size:     0.875rem;
  }

  .auth-form { display: flex; flex-direction: column; gap: 0.85rem; }

  .form-input  { font-size: 16px; }
  .code-input  {
    letter-spacing: 6px;
    text-align:     center;
    font-family:    'Courier New', monospace;
    font-size:      22px;
    font-weight:    600;
  }

  .btn-full { width: 100%; padding: 0.85rem 1.5rem; }

  .auth-footer {
    text-align: center;
    margin-top: 1rem;
    font-size:  0.875rem;
    color:      var(--color-gray-600);
  }
  .auth-footer p { margin: 0.25rem 0; }
  .auth-footer a { color: var(--color-black); font-weight: 500; }
  .auth-footer a:hover { text-decoration: underline; }

  @media (min-width: 768px) {
    .auth-card  { padding: 2.5rem; }
    .auth-title { font-size: 1.9rem; }
  }
</style>
