---
import ShopLayout from '../../layouts/ShopLayout.astro'
---

<ShopLayout title="Iniciar sesión">
  <div class="auth-page">
    <div class="auth-card">

      <div class="auth-header">
        <h1 class="auth-title">Bienvenido</h1>
        <p class="auth-subtitle">Inicia sesión en tu cuenta</p>
      </div>

      <div id="auth-error" class="auth-error" role="alert" hidden></div>

      <div class="auth-form">
        <div class="form-group">
          <label class="form-label" for="email">Correo electrónico</label>
          <input
            type="email"
            id="email"
            class="form-input"
            placeholder="tu@email.com"
            autocomplete="email"
            inputmode="email"
          />
        </div>

        <div class="form-group">
          <label class="form-label" for="password">Contraseña</label>
          <input
            type="password"
            id="password"
            class="form-input"
            placeholder="••••••••"
            autocomplete="current-password"
          />
        </div>

        <button type="button" class="btn btn-primary btn-full" id="login-btn">
          Iniciar sesión
        </button>
      </div>

      <div class="auth-footer">
        <p><a href="/auth/forgot-password">¿Olvidaste tu contraseña?</a></p>
        <p>¿No tienes cuenta? <a href="/auth/register">Regístrate gratis</a></p>
      </div>

    </div>
  </div>
</ShopLayout>

<script>
  import { api } from '../../lib/api.js'
  import { setAuth, clearAuth } from '../../stores/auth.store.js'

  const emailInput    = document.getElementById('email')
  const passwordInput = document.getElementById('password')
  const loginBtn      = document.getElementById('login-btn')
  const errorDiv      = document.getElementById('auth-error')

  const isAdmin = (role) => role === 'ADMIN' || role === 'SUPER_ADMIN'

  // Sólo rutas internas: evita redirecciones abiertas (?redirect=//evil.com o
  // /\evil.com, que los navegadores tratan como //evil.com).
  const toSafeRedirect = (value) => {
    if (!value || !value.startsWith('/') || value.startsWith('//') || value.includes('\\')) return null
    try {
      const target = new URL(value, window.location.origin)
      return target.origin === window.location.origin ? target.pathname + target.search + target.hash : null
    } catch {
      return null
    }
  }
  const safeRedirect = toSafeRedirect(new URLSearchParams(window.location.search).get('redirect'))

  const destinationFor = (user) => {
    if (safeRedirect && (!safeRedirect.startsWith('/admin') || isAdmin(user.role))) return safeRedirect
    return isAdmin(user.role) ? '/admin' : '/perfil'
  }

  // Reanudar sesión: el middleware de /admin redirige aquí cuando la cookie
  // accessToken (15 min) venció, aunque el refresh token (7 días) siga vivo.
  // /auth/me dispara el refresh automático de api.js; si funciona, volvemos
  // a la página original sin pedir la contraseña. La marca en sessionStorage
  // evita un bucle si el servidor sigue sin ver la cookie.
  const RESUME_KEY = 'auth:resumeAt'
  const tryResumeSession = async () => {
    if (!safeRedirect) return
    try {
      const last = Number(sessionStorage.getItem(RESUME_KEY) || 0)
      if (Date.now() - last < 15000) return
      sessionStorage.setItem(RESUME_KEY, String(Date.now()))
    } catch {
      return
    }
    try {
      const { user } = await api.auth.me()
      if (!user) return
      await setAuth(user).catch(() => {})
      window.location.replace(destinationFor(user))
    } catch {
      await clearAuth().catch(() => {})
    }
  }
  tryResumeSession()

  const showError = (msg) => {
    errorDiv.textContent = msg
    errorDiv.hidden = false
  }

  const hideError = () => {
    errorDiv.hidden = true
  }

  const setLoading = (loading) => {
    loginBtn.disabled = loading
    loginBtn.textContent = loading ? 'Iniciando sesión...' : 'Iniciar sesión'
  }

  loginBtn.addEventListener('click', async () => {
    hideError()

    const email    = emailInput.value.trim()
    const password = passwordInput.value

    if (!email || !password) {
      showError('Por favor completa todos los campos')
      return
    }

    setLoading(true)

    try {
      const data = await api.auth.login({ email, password })
      await setAuth(data.user).catch(() => {})
      window.location.href = destinationFor(data.user)
    } catch (err) {
      showError(err.message || 'Error al iniciar sesión')
    } finally {
      setLoading(false)
    }
  })

  passwordInput.addEventListener('keydown', (e) => {
    if (e.key === 'Enter') loginBtn.click()
  })
</script>

<style>
  .auth-page {
    min-height:      100dvh;
    display:         flex;
    align-items:     center;
    justify-content: center;
    padding:         calc(var(--header-height) + 1rem) 1rem 2rem;
    background:      var(--color-gray-50);
  }

  .auth-card {
    width:         100%;
    max-width:     440px;
    background:    var(--color-white);
    border-radius: var(--radius-lg);
    border:        1.5px solid var(--color-gray-200);
    padding:       1.5rem;
    box-shadow:    var(--shadow-sm);
  }

  .auth-header { text-align: center; margin-bottom: 1.5rem; }

  .auth-title {
    font-family:   var(--font-serif);
    font-size:     1.6rem;
    font-weight:   600;
    color:         var(--color-black);
    margin-bottom: 0.4rem;
  }

  .auth-subtitle { font-size: 0.9rem; color: var(--color-gray-500); }

  .auth-error {
    background:    #fee2e2;
    color:         #991b1b;
    padding:       0.75rem 1rem;
    border-radius: var(--radius-md);
    font-size:     0.875rem;
    margin-bottom: 0.85rem;
  }

  .auth-form { display: flex; flex-direction: column; gap: 0.85rem; }

  .form-input { font-size: 16px; }

  .btn-full { width: 100%; padding: 0.85rem 1.5rem; }

  .auth-footer {
    text-align: center;
    margin-top: 1.25rem;
    font-size:  0.875rem;
    color:      var(--color-gray-600);
  }
  .auth-footer a { color: var(--color-black); font-weight: 500; }
  .auth-footer a:hover { text-decoration: underline; }

  @media (min-width: 768px) {
    .auth-card { padding: 2.5rem; }
    .auth-title { font-size: 2rem; }
  }

  @media (prefers-reduced-motion: reduce) {
    .auth-card { box-shadow: none; }
  }
</style>