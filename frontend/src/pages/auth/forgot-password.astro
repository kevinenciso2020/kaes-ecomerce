---
import ShopLayout from '../../layouts/ShopLayout.astro'
---

<ShopLayout title="Recuperar contraseña">
  <div class="auth-page">
    <div class="auth-card">

      <div id="state-form" class="auth-state">
        <div class="auth-header">
          <h1 class="auth-title">¿Olvidaste tu contraseña?</h1>
          <p class="auth-subtitle">
            Ingresa tu correo y te enviaremos un código de 6 dígitos para restablecerla.
          </p>
        </div>

        <div id="auth-error" class="auth-error" role="alert" hidden></div>

        <div class="auth-form">
          <div class="form-group">
            <label class="form-label" for="email">Correo electrónico</label>
            <input
              type="email"
              id="email"
              class="form-input"
              placeholder="tu@email.com"
              autocomplete="email"
              inputmode="email"
            />
          </div>

          <button type="button" class="btn btn-primary btn-full" id="submit-btn">
            Enviar código
          </button>
        </div>

        <div class="auth-footer">
          <p><a href="/auth/login">← Volver a iniciar sesión</a></p>
        </div>
      </div>

      <div id="state-sent" class="auth-state" hidden>
        <div class="state-icon state-icon-success" aria-hidden="true">✓</div>
        <h1 class="auth-title">Revisa tu correo</h1>
        <p class="auth-subtitle">
          Si la cuenta existe, enviamos un código de 6 dígitos a <strong id="sent-email"></strong>.
        </p>
        <p class="auth-hint">
          El código expira en 10 minutos. Si no lo ves, revisa la carpeta de spam.
        </p>

        <a href="#" id="continue-btn" class="btn btn-primary btn-full">Ingresar el código</a>

        <div class="auth-footer">
          <p><a href="/auth/login">← Volver a iniciar sesión</a></p>
        </div>
      </div>

    </div>
  </div>
</ShopLayout>

<script>
  import { api, ApiError } from '../../lib/api.js'

  const formState = document.getElementById('state-form')
  const sentState = document.getElementById('state-sent')

  const emailInput = document.getElementById('email')
  const submitBtn  = document.getElementById('submit-btn')
  const errorDiv   = document.getElementById('auth-error')

  const sentEmailEl = document.getElementById('sent-email')
  const continueBtn = document.getElementById('continue-btn')

  const showError = (msg) => {
    if (!errorDiv) return
    errorDiv.textContent = msg
    errorDiv.hidden = false
  }

  const setLoading = (loading) => {
    if (!submitBtn) return
    submitBtn.disabled    = loading
    submitBtn.textContent = loading ? 'Enviando...' : 'Enviar código'
  }

  submitBtn?.addEventListener('click', async () => {
    if (!errorDiv) return
    errorDiv.hidden = true

    const email = emailInput.value.trim()
    if (!email) {
      showError('Por favor ingresa tu correo')
      return
    }

    setLoading(true)

    try {
      await api.auth.forgotPassword(email)

      if (formState) formState.hidden = true
      if (sentState) sentState.hidden = false
      if (sentEmailEl) sentEmailEl.textContent = email
      if (continueBtn) {
        continueBtn.href = `/auth/reset-password?email=${encodeURIComponent(email)}`
      }
    } catch (err) {
      let msg = err?.message || 'No se pudo enviar el código'
      if (err instanceof ApiError && err.status === 429) {
        msg = 'Has pedido demasiados códigos. Espera un momento antes de intentar de nuevo.'
      }
      showError(msg)
    } finally {
      setLoading(false)
    }
  })

  emailInput?.addEventListener('keydown', (e) => {
    if (e.key === 'Enter') submitBtn?.click()
  })
</script>

<style>
  .auth-page {
    min-height:  100dvh;
    display:     flex;
    align-items: center;
    justify-content: center;
    padding:     calc(var(--header-height) + 1rem) 1rem 2rem;
    background:  var(--color-gray-50);
  }

  .auth-card {
    width:         100%;
    max-width:     460px;
    background:    var(--color-white);
    border-radius: var(--radius-lg);
    border:        1.5px solid var(--color-gray-200);
    padding:       1.5rem;
    box-shadow:    var(--shadow-sm);
  }

  .auth-state {
    display:         flex;
    flex-direction:  column;
    gap:             0.85rem;
  }

  .auth-header { text-align: center; margin-bottom: 1rem; }

  .auth-title {
    font-family:   var(--font-serif);
    font-size:     1.6rem;
    font-weight:   600;
    color:         var(--color-black);
    margin:        0 0 0.4rem;
    text-align:    center;
  }

  .auth-subtitle {
    font-size:  0.9rem;
    color:      var(--color-gray-600);
    margin:     0;
    text-align: center;
  }

  .auth-hint {
    font-size:  0.85rem;
    color:      var(--color-gray-600);
    text-align: center;
    margin:     0;
  }

  .state-icon {
    width:           56px;
    height:          56px;
    border-radius:   50%;
    display:         flex;
    align-items:     center;
    justify-content: center;
    font-size:       1.6rem;
    font-weight:     700;
    margin:          0 auto 0.25rem;
  }
  .state-icon-success { background: #dcfce7; color: #166534; }

  .auth-error {
    background:    #fee2e2;
    color:         #991b1b;
    padding:       0.75rem 1rem;
    border-radius: var(--radius-md);
    font-size:     0.875rem;
  }

  .auth-form { display: flex; flex-direction: column; gap: 0.85rem; }

  .form-input { font-size: 16px; }

  .btn-full { width: 100%; padding: 0.85rem 1.5rem; }

  .auth-footer {
    text-align: center;
    margin-top: 1rem;
    font-size:  0.875rem;
    color:      var(--color-gray-600);
  }
  .auth-footer a { color: var(--color-black); font-weight: 500; }
  .auth-footer a:hover { text-decoration: underline; }

  @media (min-width: 768px) {
    .auth-card  { padding: 2.5rem; }
    .auth-title { font-size: 1.9rem; }
  }
</style>
