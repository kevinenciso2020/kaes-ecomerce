---
import ShopLayout from '../layouts/ShopLayout.astro'
import { SITE_CONFIG } from '../lib/site-config.js'

const hasSocials = (s) => s && !s.startsWith('[')
---

<ShopLayout
  title="Contacto"
  description="¿Tienes preguntas sobre Kaes Store? Escríbenos y te responderemos."
>
  <section class="contact-page container">
    <header class="contact-header">
      <p class="contact-eyebrow">Estamos para ayudarte</p>
      <h1 class="contact-title">Contáctanos</h1>
      <p class="contact-sub">
        ¿Tienes una pregunta sobre un pedido, una prenda o simplemente
        quieres saludarnos? Escríbenos y te respondemos en menos de
        48 horas hábiles.
      </p>
    </header>

    <div class="contact-grid">
      <aside class="contact-info">
        <h2 class="info-title">Información de la tienda</h2>

        <div class="info-block">
          <h3>Correo</h3>
          <a href={`mailto:${SITE_CONFIG.email}`}>{SITE_CONFIG.email}</a>
        </div>

        <div class="info-block">
          <h3>Teléfono / WhatsApp</h3>
          <p>{SITE_CONFIG.phone}</p>
          <small>Lunes a viernes, 9:00 a.m. – 6:00 p.m.</small>
        </div>

        <div class="info-block">
          <h3>Dirección</h3>
          <p>{SITE_CONFIG.address}</p>
          <p>{SITE_CONFIG.city}, Colombia</p>
        </div>

        <div class="info-block">
          <h3>Horarios de atención</h3>
          <p>{SITE_CONFIG.schedule.weekdays}</p>
          <p>{SITE_CONFIG.schedule.saturday}</p>
          <p>{SITE_CONFIG.schedule.sunday}</p>
        </div>

        {(hasSocials(SITE_CONFIG.social.instagram) || hasSocials(SITE_CONFIG.social.facebook) || hasSocials(SITE_CONFIG.social.tiktok)) && (
          <div class="info-block">
            <h3>Síguenos</h3>
            <div class="social-links">
              {hasSocials(SITE_CONFIG.social.instagram) && (
                <a href={SITE_CONFIG.social.instagram} aria-label="Instagram" target="_blank" rel="noopener">
                  <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                    <rect x="2" y="2" width="20" height="20" rx="5" ry="5"/>
                    <path d="M16 11.37A4 4 0 1112.63 8 4 4 0 0116 11.37z"/>
                    <line x1="17.5" y1="6.5" x2="17.51" y2="6.5"/>
                  </svg>
                  <span>Instagram</span>
                </a>
              )}
              {hasSocials(SITE_CONFIG.social.facebook) && (
                <a href={SITE_CONFIG.social.facebook} aria-label="Facebook" target="_blank" rel="noopener">
                  <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                    <path d="M18 2h-3a5 5 0 00-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 011-1h3z"/>
                  </svg>
                  <span>Facebook</span>
                </a>
              )}
              {hasSocials(SITE_CONFIG.social.tiktok) && (
                <a href={SITE_CONFIG.social.tiktok} aria-label="TikTok" target="_blank" rel="noopener">
                  <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                    <path d="M16 4a4 4 0 004 4v3a7 7 0 01-4-1.3V16a6 6 0 11-6-6v3a3 3 0 103 3V2h3a4 4 0 010 2z"/>
                  </svg>
                  <span>TikTok</span>
                </a>
              )}
            </div>
          </div>
        )}
      </aside>

      <div class="contact-form-wrap">
        <h2 class="form-title">Envíanos un mensaje</h2>
        <p class="form-sub">
          Completa el formulario y nos pondremos en contacto contigo en menos
          de 48 horas hábiles. También puedes escribirnos directamente a
          <a href={`mailto:${SITE_CONFIG.email}`}>{SITE_CONFIG.email}</a>.
        </p>

        <div id="form-success" class="alert alert-success" style="display:none">
          <strong>¡Mensaje enviado!</strong> Te responderemos pronto a tu correo.
        </div>

        <div id="form-error" class="alert alert-error" style="display:none">
          <strong>Error:</strong> <span id="form-error-msg"></span>
        </div>

        <form id="contact-form" class="contact-form" novalidate>
          <div class="form-group">
            <label class="form-label" for="contact-nombre">Nombre</label>
            <input
              type="text"
              id="contact-nombre"
              name="name"
              class="form-input"
              required
              minlength="2"
              maxlength="100"
              placeholder="Tu nombre completo"
            />
          </div>

          <div class="form-group">
            <label class="form-label" for="contact-email">Email</label>
            <input
              type="email"
              id="contact-email"
              name="email"
              class="form-input"
              required
              placeholder="tu@correo.com"
            />
          </div>

          <div class="form-group">
            <label class="form-label" for="contact-asunto">Asunto <span class="opcional">(opcional)</span></label>
            <input
              type="text"
              id="contact-asunto"
              name="subject"
              class="form-input"
              maxlength="200"
              placeholder="¿Sobre qué quieres hablar?"
            />
          </div>

          <div class="form-group">
            <label class="form-label" for="contact-mensaje">Mensaje</label>
            <textarea
              id="contact-mensaje"
              name="message"
              class="form-input"
              required
              minlength="10"
              maxlength="2000"
              rows="6"
              placeholder="Cuéntanos en qué podemos ayudarte..."
            ></textarea>
          </div>

          <button type="submit" class="btn btn-primary" id="submit-btn">
            Enviar mensaje
          </button>
        </form>
      </div>
    </div>
  </section>
</ShopLayout>

<script>
  import { api } from '../lib/api.js'

  const form = document.getElementById('contact-form')
  const successEl = document.getElementById('form-success')
  const errorEl = document.getElementById('form-error')
  const errorMsg = document.getElementById('form-error-msg')
  const submitBtn = document.getElementById('submit-btn')

  function showSuccess() {
    successEl.style.display = 'block'
    errorEl.style.display = 'none'
    form.reset()
  }

  function showError(msg) {
    errorMsg.textContent = msg
    errorEl.style.display = 'block'
    successEl.style.display = 'none'
  }

  function setLoading(loading) {
    submitBtn.disabled = loading
    submitBtn.textContent = loading ? 'Enviando...' : 'Enviar mensaje'
  }

  form?.addEventListener('submit', async (e) => {
    e.preventDefault()
    setLoading(true)

    const data = {
      name:    form.name.value.trim(),
      email:   form.email.value.trim(),
      subject: form.subject.value.trim() || null,
      message: form.message.value.trim(),
    }

    try {
      await api.contact.send(data)
      showSuccess()
    } catch (err) {
      showError(err.message || 'No se pudo enviar el mensaje. Intenta de nuevo.')
    } finally {
      setLoading(false)
    }
  })
</script>

<style>
  .contact-page {
    max-width: 1100px;
    margin: 0 auto;
    padding: calc(var(--header-height) + 2rem) var(--container-padding) 4rem;
  }

  .contact-header {
    max-width: 640px;
    margin-bottom: 3rem;
  }

  .contact-eyebrow {
    font-size: 0.7rem;
    font-weight: 600;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--color-gray-500);
    margin-bottom: 0.5rem;
  }

  .contact-title {
    font-family: var(--font-serif);
    font-size: clamp(2rem, 4vw, 2.5rem);
    font-weight: 600;
    color: var(--color-black);
    margin: 0 0 0.75rem;
    line-height: 1.2;
  }

  .contact-sub {
    font-size: 1rem;
    color: var(--color-gray-500);
    margin: 0;
  }

  .contact-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 3rem;
  }

  @media (min-width: 768px) {
    .contact-grid {
      grid-template-columns: 320px 1fr;
      gap: 3rem;
    }
  }

  .contact-info {
    display: flex;
    flex-direction: column;
    gap: 1.75rem;
  }

  .info-title {
    font-family: var(--font-serif);
    font-size: 1.25rem;
    font-weight: 600;
    color: var(--color-black);
    margin: 0;
    padding-bottom: 1rem;
    border-bottom: 1px solid var(--color-gray-200);
  }

  .info-block h3 {
    font-size: 0.7rem;
    font-weight: 600;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: var(--color-gray-500);
    margin-bottom: 0.5rem;
  }

  .info-block p,
  .info-block a {
    font-size: 0.95rem;
    color: var(--color-gray-700);
    margin: 0;
  }

  .info-block a {
    color: var(--color-black);
    text-decoration: underline;
    word-break: break-all;
  }

  .info-block small {
    display: block;
    margin-top: 0.25rem;
    font-size: 0.8rem;
    color: var(--color-gray-400);
  }

  .social-links {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .social-links a {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    color: var(--color-gray-700);
    text-decoration: none;
    transition: color 150ms ease;
  }

  .social-links a:hover {
    color: var(--color-black);
  }

  .contact-form-wrap {
    background: var(--color-white);
    border: 1px solid var(--color-gray-200);
    border-radius: var(--radius-lg);
    padding: 2rem;
  }

  .form-title {
    font-family: var(--font-serif);
    font-size: 1.25rem;
    font-weight: 600;
    color: var(--color-black);
    margin: 0 0 0.5rem;
  }

  .form-sub {
    font-size: 0.875rem;
    color: var(--color-gray-500);
    margin: 0 0 1.5rem;
  }

  .form-sub a {
    color: var(--color-black);
    text-decoration: underline;
  }

  .alert {
    padding: 0.75rem 1rem;
    border-radius: var(--radius-md);
    margin-bottom: 1rem;
    font-size: 0.9rem;
  }

  .alert-success {
    background: #dcfce7;
    color: #166534;
    border: 1px solid #86efac;
  }

  .alert-error {
    background: #fee2e2;
    color: #991b1b;
    border: 1px solid #fca5a5;
  }

  .contact-form {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .form-group {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }

  .form-label {
    font-size: 0.875rem;
    font-weight: 500;
    color: var(--color-black);
  }

  .opcional {
    color: var(--color-gray-400);
    font-weight: 400;
    font-size: 0.8rem;
  }

  .form-input {
    padding: 0.75rem 1rem;
    border: 1px solid var(--color-gray-200);
    border-radius: var(--radius-md);
    font-size: 0.95rem;
    transition: border-color 150ms ease;
  }

  .form-input:focus {
    outline: none;
    border-color: var(--color-black);
  }

  textarea.form-input {
    resize: vertical;
    font-family: inherit;
  }

  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 0.875rem 1.5rem;
    font-size: 0.95rem;
    font-weight: 500;
    border-radius: var(--radius-md);
    border: 1px solid transparent;
    cursor: pointer;
    transition: all 150ms ease;
  }

  .btn-primary {
    background: var(--color-black);
    color: var(--color-white);
    border-color: var(--color-black);
  }

  .btn-primary:hover:not(:disabled) {
    background: var(--color-gray-800);
  }

  .btn-primary:disabled {
    opacity: 0.6;
    cursor: not-allowed;
  }
</style>
