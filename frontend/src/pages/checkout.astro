---
import ShopLayout from '../layouts/ShopLayout.astro'
import UbicacionSelect from '../components/UbicacionSelect.jsx'
import Icon from '../components/ui/Icon.astro'
---

<ShopLayout title="Checkout">
  <div class="checkout-page container">

    <h1 class="page-title">Finalizar compra</h1>

    <div id="checkout-empty" hidden class="checkout-empty">
      <p>No tienes productos en el carrito</p>
      <a href="/productos" class="btn btn-primary">Ver productos</a>
    </div>

    <div id="checkout-content" hidden class="checkout-layout">

      <div class="checkout-form">

        <fieldset class="form-section">
          <legend class="section-title">Información de contacto</legend>
          <div class="form-grid">
            <div class="form-group">
              <label class="form-label" for="full-name">Nombre completo</label>
              <input type="text" id="full-name" class="form-input" placeholder="Tu nombre" autocomplete="name" required />
            </div>
            <div class="form-group">
              <label class="form-label" for="phone">Teléfono</label>
              <input type="tel" id="phone" class="form-input" placeholder="300 000 0000" autocomplete="tel" inputmode="numeric" required />
            </div>
          </div>
        </fieldset>

        <fieldset class="form-section">
          <legend class="section-title">Dirección de envío</legend>
          <div class="form-group">
            <label class="form-label" for="street">Dirección</label>
            <input type="text" id="street" class="form-input" placeholder="Calle, número, apto" autocomplete="street-address" required />
          </div>
          <div class="form-grid">
            <div class="form-group">
              <label class="form-label" for="zipCode">Código postal</label>
              <input type="text" id="zipCode" class="form-input" placeholder="050010" inputmode="numeric" autocomplete="postal-code" />
            </div>
          </div>
          <UbicacionSelect client:load id="ubicacion" required={true} />
          <input type="hidden" id="address-departamento" />
          <input type="hidden" id="address-municipio" />
        </fieldset>

        <fieldset class="form-section">
          <legend class="section-title">Método de pago</legend>
          <div class="payment-methods" role="radiogroup" aria-label="Métodos de pago">
            <label class="payment-option">
              <input type="radio" name="payment" value="wompi" checked />
              <div class="payment-card">
                <span class="payment-icon"><Icon name="card" size={22} /></span>
                <div>
                  <p class="payment-name">Wompi</p>
                  <p class="payment-desc">Tarjetas, Nequi, PSE, Daviplata</p>
                </div>
              </div>
            </label>
            <label class="payment-option">
              <input type="radio" name="payment" value="mercadopago" />
              <div class="payment-card">
                <span class="payment-icon"><Icon name="bank" size={22} /></span>
                <div>
                  <p class="payment-name">MercadoPago</p>
                  <p class="payment-desc">PSE, Nequi, efectivo y más</p>
                </div>
              </div>
            </label>
          </div>
        </fieldset>

        <div id="checkout-error" class="checkout-error" role="alert" hidden></div>

        <button type="button" class="btn btn-primary btn-full" id="place-order-btn">
          Confirmar pedido
        </button>

      </div>

      <aside class="order-summary" aria-label="Resumen del pedido">
        <h2 class="summary-title">Tu pedido</h2>
        <div id="order-items"></div>
        <div class="summary-divider"></div>

        <div class="coupon-section">
          <div class="coupon-input-group">
            <label for="coupon-code" class="sr-only">Código de cupón</label>
            <input type="text" id="coupon-code" class="coupon-input" placeholder="Código de cupón" autocomplete="off" />
            <button type="button" id="apply-coupon-btn" class="coupon-btn">Aplicar</button>
          </div>
          <div id="coupon-message" class="coupon-message"></div>
          <div id="coupon-applied" hidden class="coupon-applied">
            <span id="applied-code"></span>
            <button type="button" id="remove-coupon-btn" class="remove-coupon-btn" aria-label="Eliminar cupón">✕</button>
          </div>
        </div>

        <div class="summary-divider"></div>
        <div class="summary-row">
          <span>Subtotal</span>
          <span id="order-subtotal">$0</span>
        </div>
        <div class="summary-row" id="discount-row" hidden>
          <span>Descuento</span>
          <span id="order-discount" class="discount-amount">-$0</span>
        </div>
        <div class="summary-row">
          <span>Envío</span>
          <span class="shipping-free">Gratis</span>
        </div>
        <div class="summary-divider"></div>
        <div class="summary-row total-row">
          <span>Total</span>
          <span id="order-total">$0</span>
        </div>
      </aside>

    </div>
  </div>
</ShopLayout>

<script>
  import { cartItems, cartTotal, clearCart } from '../stores/cart.store.js'
  import { applyCoupon, removeCoupon, getCouponCode } from '../stores/coupon.store.js'
  import { api } from '../lib/api.js'
  import { sanitizeCartItem, escapeHtml } from '../lib/sanitize.js'

  let currentDiscount = 0
  let appliedCouponData = null

  document.addEventListener('ubicacion-change', (e) => {
    const detail = e.detail
    const depEl = document.getElementById('address-departamento')
    const munEl = document.getElementById('address-municipio')
    if (depEl) depEl.value = detail?.departamento || ''
    if (munEl) munEl.value = detail?.municipio || ''
  })

  const savedCoupon = getCouponCode()
  if (savedCoupon) {
    const codeEl = document.getElementById('applied-code')
    const appliedEl = document.getElementById('coupon-applied')
    const inputEl = document.getElementById('coupon-code')
    if (codeEl) codeEl.textContent = savedCoupon
    if (appliedEl) appliedEl.hidden = false
    if (inputEl) inputEl.hidden = true
  }

  const updateTotals = (subtotal, discount = 0) => {
    currentDiscount = discount
    const discountRow = document.getElementById('discount-row')
    const discountEl = document.getElementById('order-discount')
    const totalEl = document.getElementById('order-total')

    if (discount > 0 && discountRow && discountEl && totalEl) {
      discountRow.hidden = false
      discountEl.textContent = '-$' + Number(discount).toLocaleString('es-CO')
      const total = subtotal - discount
      totalEl.textContent = '$' + Number(Math.max(0, total)).toLocaleString('es-CO')
    } else if (totalEl) {
      discountRow.hidden = true
      totalEl.textContent = '$' + Number(subtotal).toLocaleString('es-CO')
    }
  }

  const setCouponMessage = (msg, text, type) => {
    if (!msg) return
    msg.textContent = text
    msg.className = `coupon-message${type ? ' ' + type : ''}`
  }

  document.getElementById('apply-coupon-btn')?.addEventListener('click', async () => {
    const codeInput = document.getElementById('coupon-code')
    const messageEl = document.getElementById('coupon-message')
    const appliedEl = document.getElementById('coupon-applied')

    const code = codeInput?.value.trim().toUpperCase() || ''
    if (!code) {
      setCouponMessage(messageEl, 'Ingresa un código', 'error')
      return
    }

    try {
      const result = await api.coupons.validate(code)

      if (result.valid) {
        appliedCouponData = result.coupon
        applyCoupon(code, result.coupon)

        const codeEl = document.getElementById('applied-code')
        if (codeEl) codeEl.textContent = code
        if (appliedEl) appliedEl.hidden = false
        if (codeInput) codeInput.hidden = true
        setCouponMessage(
          messageEl,
          result.coupon.type === 'PERCENTAGE'
            ? `${result.coupon.value}% de descuento aplicado`
            : `$${Number(result.coupon.value).toLocaleString('es-CO')} de descuento aplicado`,
          'success'
        )

        const subtotal = cartTotal.get()
        const discount = result.coupon.type === 'PERCENTAGE'
          ? subtotal * (parseFloat(result.coupon.value) / 100)
          : parseFloat(result.coupon.value)
        updateTotals(subtotal, discount)
      } else {
        setCouponMessage(messageEl, result.message || 'Cupón inválido', 'error')
      }
    } catch (err) {
      setCouponMessage(messageEl, err.message || 'Error al validar cupón', 'error')
    }
  })

  document.getElementById('remove-coupon-btn')?.addEventListener('click', () => {
    removeCoupon()
    appliedCouponData = null

    const codeInput = document.getElementById('coupon-code')
    const appliedEl = document.getElementById('coupon-applied')
    const messageEl = document.getElementById('coupon-message')

    if (codeInput) {
      codeInput.hidden = false
      codeInput.value = ''
    }
    if (appliedEl) appliedEl.hidden = true
    setCouponMessage(messageEl, '', '')

    const subtotal = cartTotal.get()
    updateTotals(subtotal, 0)
  })

  const items = cartItems.get().map(sanitizeCartItem)
  const subtotal = cartTotal.get()

  if (items.length === 0) {
    const el = document.getElementById('checkout-empty')
    if (el) el.hidden = false
  } else {
    const el = document.getElementById('checkout-content')
    if (el) el.hidden = false

    const orderItemsEl = document.getElementById('order-items')
    if (orderItemsEl) {
      orderItemsEl.innerHTML = items.map(item => `
        <div class="order-item">
          <div class="order-item-image">
            ${item.image
              ? `<img src="${escapeHtml(item.image)}" alt="${escapeHtml(item.name)}" loading="lazy" />`
              : `<div class="order-item-placeholder"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M21 16V8a2 2 0 00-1-1.73l-7-4a2 2 0 00-2 0l-7 4A2 2 0 003 8v8a2 2 0 001 1.73l7 4a2 2 0 002 0l7-4A2 2 0 0021 16z"/><polyline points="3.27 6.96 12 12.01 20.73 6.96"/><line x1="12" y1="22.08" x2="12" y2="12"/></svg></div>`
            }
            <span class="order-item-qty">${item.quantity}</span>
          </div>
          <div class="order-item-info">
            <p class="order-item-name">${escapeHtml(item.name)}</p>
            ${item.size  ? `<p class="order-item-variant">Talla: ${escapeHtml(item.size)}</p>`  : ''}
            ${item.color ? `<p class="order-item-variant">Color: ${escapeHtml(item.color)}</p>` : ''}
          </div>
          <p class="order-item-price">$${Number(item.price * item.quantity).toLocaleString('es-CO')}</p>
        </div>
      `).join('')
    }

    const formatted = '$' + Number(subtotal).toLocaleString('es-CO')
    const sub = document.getElementById('order-subtotal')
    const tot = document.getElementById('order-total')
    if (sub) sub.textContent = formatted
    if (tot) tot.textContent = formatted
  }

  document.getElementById('place-order-btn')?.addEventListener('click', async () => {
    const { bootstrapAuth } = await import('../lib/api.js')
    const user = await bootstrapAuth()
    if (!user) {
      window.location.href = '/auth/login'
      return
    }

    const fullNameInput   = document.getElementById('full-name')
    const phoneInput      = document.getElementById('phone')
    const streetInput     = document.getElementById('street')
    const zipInput        = document.getElementById('zipCode')
    const departamentoInput = document.getElementById('address-departamento')
    const municipioInput  = document.getElementById('address-municipio')

    const errorEl = document.getElementById('checkout-error')
    const btn     = document.getElementById('place-order-btn')

    const fullName     = fullNameInput?.value.trim() || ''
    const phone        = phoneInput?.value.trim() || ''
    const street       = streetInput?.value.trim() || ''
    const zipCode      = zipInput?.value.trim() || ''
    const departamento = departamentoInput?.value.trim() || ''
    const municipio    = municipioInput?.value.trim() || ''

    if (!fullName || !phone || !street || !departamento || !municipio) {
      if (errorEl) {
        errorEl.textContent = 'Por favor completa todos los campos requeridos (incluyendo departamento y municipio)'
        errorEl.hidden = false
      }
      return
    }

    const paymentMethod = document.querySelector('input[name="payment"]:checked')?.value || 'wompi'

    if (!btn) {
      return
    }
    btn.disabled    = true
    btn.textContent = 'Procesando...'
    errorEl.hidden = true

    try {
      const couponCode = getCouponCode() || undefined

      const orderItems = cartItems.get().map(item => ({
        productId: item.id,
        quantity:  item.quantity,
        size:      item.size,
        color:     item.color,
      }))

      const order = await api.orders.create({
        items: orderItems,
        couponCode,
        address: {
          fullName,
          phone,
          street,
          zipCode: zipCode || undefined,
          departamento,
          municipio,
          label: 'Casa',
        },
      })

      let paymentUrl = null

      if (paymentMethod === 'wompi') {
        const wompiResponse = await api.payments.wompi.createCheckout(order.id)
        paymentUrl = wompiResponse.paymentLink
      } else if (paymentMethod === 'mercadopago') {
        const mpResponse = await api.payments.createPreference({
          orderId: order.id,
          items: orderItems,
          payer: { email: JSON.parse(user).email, name: fullName },
        })
        paymentUrl = mpResponse.sandboxInitPoint || mpResponse.initPoint
      }

      clearCart()
      removeCoupon()

      if (paymentUrl) {
        window.location.href = paymentUrl
      } else {
        window.location.href = `/perfil/ordenes?success=true&orderId=${order.id}`
      }

    } catch (err) {
      if (errorEl) {
        errorEl.textContent = err.message || 'Error al procesar el pedido'
        errorEl.hidden = false
      }
      if (btn) {
        btn.disabled    = false
        btn.textContent = 'Confirmar pedido'
      }
    }
  })
</script>

<style>
  .sr-only {
    position:    absolute;
    width:       1px;
    height:      1px;
    padding:     0;
    margin:      -1px;
    overflow:    hidden;
    clip:        rect(0, 0, 0, 0);
    white-space: nowrap;
    border:      0;
  }

  .checkout-page {
    padding-top:    calc(var(--header-height) + 1.5rem);
    padding-bottom: 3rem;
    max-width:      var(--max-width);
    margin:         0 auto;
  }

  .page-title {
    font-family:   var(--font-serif);
    font-size:     1.6rem;
    font-weight:   600;
    color:         var(--color-black);
    margin-bottom: 1.5rem;
  }

  .checkout-empty {
    flex-direction:  column;
    align-items:     center;
    justify-content: center;
    gap:             1rem;
    padding:         4rem 1rem;
    text-align:      center;
    color:           var(--color-gray-500);
  }

  .checkout-layout {
    display:               grid;
    grid-template-columns: 1fr;
    gap:                   2rem;
    align-items:           start;
  }

  .form-section {
    margin:        0 0 1.5rem 0;
    padding:       0 0 1.5rem 0;
    border:        none;
    border-bottom: 1.5px solid var(--color-gray-200);
  }
  .form-section:last-of-type { border-bottom: none; }

  .section-title {
    font-size:     0.95rem;
    font-weight:   600;
    color:         var(--color-black);
    margin-bottom: 1rem;
    padding:       0;
  }

  .form-grid {
    display:               grid;
    grid-template-columns: 1fr;
    gap:                   0.85rem;
  }

  .payment-methods {
    display:        flex;
    flex-direction: column;
    gap:            0.6rem;
  }

  .payment-option {
    cursor:     pointer;
    display:    block;
    position:   relative;
  }

  .payment-option input {
    position:        absolute;
    opacity:         0;
    pointer-events:  none;
  }

  .payment-card {
    display:       flex;
    align-items:   center;
    gap:           0.85rem;
    padding:       0.85rem 1rem;
    border:        1.5px solid var(--color-gray-200);
    border-radius: var(--radius-lg);
    transition:    all var(--transition);
  }

  .payment-option input:checked + .payment-card {
    border-color: var(--color-black);
    background:   var(--color-gray-50);
  }

  .payment-option input:focus-visible + .payment-card {
    outline:        2px solid var(--color-black);
    outline-offset: 2px;
  }

  .payment-icon {
    width:           44px;
    height:          44px;
    display:         flex;
    align-items:     center;
    justify-content: center;
    background:      var(--color-gray-100);
    border-radius:   var(--radius-md);
    color:           var(--color-black);
  }

  .payment-name { font-size: 0.9rem;  font-weight: 500; color: var(--color-black); margin: 0; }
  .payment-desc { font-size: 0.78rem; color: var(--color-gray-500); margin: 0; }

  .checkout-error {
    background:    #fee2e2;
    color:         #991b1b;
    padding:       0.75rem 1rem;
    border-radius: var(--radius-md);
    font-size:     0.875rem;
    margin-bottom: 0.85rem;
  }

  .btn-full { width: 100%; padding: 0.95rem 1.5rem; }

  .order-summary {
    background:    var(--color-white);
    border:        1.5px solid var(--color-gray-200);
    border-radius: var(--radius-lg);
    padding:       1.25rem;
  }

  .summary-title {
    font-size:     1rem;
    font-weight:   600;
    color:         var(--color-black);
    margin-bottom: 0.85rem;
  }

  .order-item {
    display:     flex;
    align-items: center;
    gap:         0.6rem;
    padding:     0.5rem 0;
  }

  .order-item-image {
    position:      relative;
    width:         50px;
    height:        64px;
    border-radius: var(--radius-md);
    overflow:      hidden;
    background:    var(--color-gray-100);
    flex-shrink:   0;
  }
  .order-item-image img { width: 100%; height: 100%; object-fit: cover; }
  .order-item-placeholder {
    width:        100%;
    height:       100%;
    display:      flex;
    align-items:  center;
    justify-content: center;
    color:        var(--color-gray-400);
  }

  .order-item-qty {
    position:        absolute;
    top:             -6px;
    right:           -6px;
    background:      var(--color-black);
    color:           white;
    font-size:       0.6rem;
    font-weight:     600;
    min-width:       18px;
    height:          18px;
    padding:         0 5px;
    border-radius:   var(--radius-full);
    display:         flex;
    align-items:     center;
    justify-content: center;
  }

  .order-item-info { flex: 1; min-width: 0; }
  .order-item-name    { font-size: 0.85rem; font-weight: 500; color: var(--color-black); margin: 0; }
  .order-item-variant { font-size: 0.7rem; color: var(--color-gray-500); margin: 0; }
  .order-item-price   { font-size: 0.85rem; font-weight: 600; color: var(--color-black); margin: 0; white-space: nowrap; }

  .summary-divider {
    height:     1.5px;
    background: var(--color-gray-200);
    margin:     0.85rem 0;
  }

  .summary-row {
    display:         flex;
    justify-content: space-between;
    font-size:       0.9rem;
    color:           var(--color-gray-600);
    margin-bottom:   0.6rem;
  }

  .discount-amount { color: var(--color-success); }
  .shipping-free   { color: var(--color-success); font-weight: 500; }

  .coupon-section { margin-bottom: 0.85rem; }
  .coupon-input-group { display: flex; gap: 0.5rem; }
  .coupon-input {
    flex:        1;
    min-width:   0;
    padding:     0.5rem 0.75rem;
    border:      1.5px solid var(--color-gray-200);
    border-radius: var(--radius-md);
    font-size:   0.85rem;
    text-transform: uppercase;
  }
  .coupon-input:focus { outline: none; border-color: var(--color-black); }
  .coupon-btn {
    padding:       0.5rem 1rem;
    background:    var(--color-black);
    color:         white;
    border:        none;
    border-radius: var(--radius-md);
    font-size:     0.85rem;
    font-weight:   500;
    cursor:        pointer;
  }
  .coupon-btn:disabled { opacity: 0.6; cursor: not-allowed; }

  .coupon-message {
    font-size:    0.75rem;
    margin-top:   0.4rem;
    min-height:   1em;
  }
  .coupon-message.error   { color: #991b1b; }
  .coupon-message.success { color: #166534; }

  .coupon-applied {
    display:         flex;
    align-items:     center;
    justify-content: space-between;
    padding:         0.5rem 0.75rem;
    background:      #dcfce7;
    border:          1px solid var(--color-success);
    border-radius:   var(--radius-md);
    font-size:       0.85rem;
    color:           #166534;
    margin-top:      0.4rem;
  }
  .remove-coupon-btn {
    background: none;
    border:     none;
    color:      var(--color-gray-500);
    cursor:     pointer;
    font-size:  0.95rem;
    padding:    0 0.25rem;
  }
  .remove-coupon-btn:hover { color: var(--color-danger); }

  .total-row {
    font-size:      1.05rem;
    font-weight:    600;
    color:          var(--color-black);
    margin-bottom:  1.25rem;
  }

  @media (min-width: 768px) {
    .checkout-page { padding-top: calc(var(--header-height) + 2rem); padding-bottom: 4rem; }
    .checkout-layout { grid-template-columns: 1fr 360px; gap: 2rem; }
    .form-grid { grid-template-columns: 1fr 1fr; }
    .page-title { font-size: 2rem; }
  }

  @media (min-width: 1024px) {
    .checkout-layout { grid-template-columns: 1fr 380px; gap: 2.5rem; }
    .order-summary { position: sticky; top: calc(var(--header-height) + 1rem); }
  }

  @media (prefers-reduced-motion: reduce) {
    .payment-card { transition: none; }
  }
</style>