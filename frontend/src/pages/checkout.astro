---
import ShopLayout from '../layouts/ShopLayout.astro'
import UbicacionSelect from '../components/UbicacionSelect.jsx'
import Icon from '../components/ui/Icon.astro'
---

<ShopLayout title="Checkout">
  <div class="checkout-page container">

    <h1 class="page-title">Finalizar compra</h1>

    <div id="checkout-empty" hidden class="checkout-empty">
      <p>No tienes productos en el carrito</p>
      <a href="/productos" class="btn btn-primary">Ver productos</a>
    </div>

    <div id="checkout-content" hidden class="checkout-layout">

      <div class="checkout-form">

        <fieldset class="form-section">
          <legend class="section-title">Información de contacto</legend>
          <div class="form-grid">
            <div class="form-group">
              <label class="form-label" for="full-name">Nombre completo</label>
              <input type="text" id="full-name" class="form-input" placeholder="Tu nombre" autocomplete="name" required />
            </div>
            <div class="form-group">
              <label class="form-label" for="phone">Teléfono</label>
              <input type="tel" id="phone" class="form-input" placeholder="300 000 0000" autocomplete="tel" inputmode="numeric" required />
            </div>
          </div>
        </fieldset>

        <fieldset class="form-section">
          <legend class="section-title">Dirección de envío</legend>
          <div class="form-group">
            <label class="form-label" for="street">Dirección</label>
            <input type="text" id="street" class="form-input" placeholder="Calle, número, apto" autocomplete="street-address" required />
          </div>
          <div class="form-grid">
            <div class="form-group">
              <label class="form-label" for="zipCode">Código postal</label>
              <input type="text" id="zipCode" class="form-input" placeholder="050010" inputmode="numeric" autocomplete="postal-code" />
            </div>
          </div>
          <UbicacionSelect client:load id="ubicacion" required={true} />
          <input type="hidden" id="address-departamento" />
          <input type="hidden" id="address-municipio" />
        </fieldset>

        <fieldset class="form-section">
          <legend class="section-title">Método de pago</legend>
          <div class="payment-methods" role="radiogroup" aria-label="Métodos de pago">
            <label class="payment-option" id="pm-wompi">
              <input type="radio" name="payment" value="wompi" checked />
              <div class="payment-card">
                <span class="payment-icon"><Icon name="card" size={22} /></span>
                <div>
                  <p class="payment-name">Wompi</p>
                  <p class="payment-desc">Tarjeta, PSE, Nequi, Bancolombia</p>
                </div>
              </div>
            </label>
            <label class="payment-option" id="pm-mercadopago">
              <input type="radio" name="payment" value="mercadopago" />
              <div class="payment-card">
                <span class="payment-icon"><Icon name="bank" size={22} /></span>
                <div>
                  <p class="payment-name">MercadoPago</p>
                  <p class="payment-desc">PSE, Nequi, efectivo y más</p>
                </div>
              </div>
            </label>
          </div>
        </fieldset>

        <p id="payment-unavailable" class="checkout-error" hidden>
          Los pagos en línea no están disponibles en este momento. Intenta más tarde o escríbenos.
        </p>

        <label class="consent-row">
          <input type="checkbox" id="accept-terms" />
          <span>
            Acepto los <a href="/legal/terminos-y-condiciones" target="_blank" rel="noopener">Términos y condiciones</a>,
            la <a href="/legal/politica-de-devoluciones" target="_blank" rel="noopener">Política de cambios y devoluciones</a>
            y autorizo el tratamiento de mis datos según la
            <a href="/legal/politica-de-privacidad" target="_blank" rel="noopener">Política de tratamiento de datos</a> (Ley 1581 de 2012).
          </span>
        </label>

        <div id="checkout-error" class="checkout-error" role="alert" hidden></div>

        <button type="button" class="btn btn-primary btn-full" id="place-order-btn">
          Confirmar pedido y pagar
        </button>
        <p class="checkout-hint">Serás redirigido a la pasarela de pago segura. Tienes 2 horas para pagar tu pedido.</p>

      </div>

      <aside class="order-summary" aria-label="Resumen del pedido">
        <h2 class="summary-title">Tu pedido</h2>
        <div id="order-items"></div>
        <div class="summary-divider"></div>

        <div class="coupon-section">
          <div class="coupon-input-group">
            <label for="coupon-code" class="sr-only">Código de cupón</label>
            <input type="text" id="coupon-code" class="coupon-input" placeholder="Código de cupón" autocomplete="off" />
            <button type="button" id="apply-coupon-btn" class="coupon-btn">Aplicar</button>
          </div>
          <div id="coupon-message" class="coupon-message"></div>
          <div id="coupon-applied" hidden class="coupon-applied">
            <span id="applied-code"></span>
            <button type="button" id="remove-coupon-btn" class="remove-coupon-btn" aria-label="Eliminar cupón">✕</button>
          </div>
        </div>

        <div class="summary-divider"></div>
        <div class="summary-row">
          <span>Subtotal</span>
          <span id="order-subtotal">$0</span>
        </div>
        <div class="summary-row" id="discount-row" hidden>
          <span>Descuento</span>
          <span id="order-discount" class="discount-amount">-$0</span>
        </div>
        <div class="summary-row">
          <span>Envío</span>
          <span id="order-shipping">—</span>
        </div>
        <div class="summary-divider"></div>
        <div class="summary-row total-row">
          <span>Total</span>
          <span id="order-total">$0</span>
        </div>
        <p class="tax-note">IVA incluido</p>
        <div id="quote-error" class="checkout-error" role="alert" hidden></div>
      </aside>

    </div>
  </div>
</ShopLayout>

<script>
  import { cartItems, ensureCartLoaded } from '../stores/cart.store.js'
  import { applyCoupon, removeCoupon, getCouponCode } from '../stores/coupon.store.js'
  import { api, ApiError, bootstrapAuth } from '../lib/api.js'
  import { escapeHtml } from '../lib/sanitize.js'

  const $ = (id) => document.getElementById(id)
  const money = (n) => '$' + Math.round(Number(n) || 0).toLocaleString('es-CO')

  let lastQuote = null
  let placing = false

  // UbicacionSelect emite el evento en window (no en document).
  window.addEventListener('ubicacion-change', (e) => {
    const detail = e.detail
    if ($('address-departamento')) $('address-departamento').value = detail?.departamento || ''
    if ($('address-municipio')) $('address-municipio').value = detail?.municipio || ''
  })

  const cartPayload = () =>
    cartItems.get().map((item) => ({
      productId: item.id,
      quantity: item.quantity,
      size: item.size || null,
      color: item.color || null,
    }))

  const showError = (el, html, isHtml = false) => {
    if (!el) return
    if (isHtml) el.innerHTML = html
    else el.textContent = html
    el.hidden = !html
  }

  // ── Resumen calculado por el servidor ─────────────────────────
  const renderQuote = (quote) => {
    lastQuote = quote
    $('order-items').innerHTML = quote.items.map((item) => `
      <div class="order-item">
        <div class="order-item-image">
          ${item.image
            ? `<img src="${escapeHtml(item.image)}" alt="${escapeHtml(item.name)}" loading="lazy" />`
            : '<div class="order-item-placeholder"></div>'}
          <span class="order-item-qty">${item.quantity}</span>
        </div>
        <div class="order-item-info">
          <p class="order-item-name">${escapeHtml(item.name)}</p>
          ${item.size ? `<p class="order-item-variant">Talla: ${escapeHtml(item.size)}</p>` : ''}
          ${item.color ? `<p class="order-item-variant">Color: ${escapeHtml(item.color)}</p>` : ''}
          ${item.unitPrice < item.basePrice ? `<p class="order-item-variant">Antes ${money(item.basePrice)}</p>` : ''}
        </div>
        <p class="order-item-price">${money(item.lineTotal)}</p>
      </div>`).join('')

    $('order-subtotal').textContent = money(quote.subtotal)
    $('discount-row').hidden = !(quote.discount > 0)
    $('order-discount').textContent = '-' + money(quote.discount)
    $('order-shipping').textContent = quote.shipping > 0 ? money(quote.shipping) : 'Gratis'
    $('order-total').textContent = money(quote.total)

    const code = getCouponCode()
    if (code && quote.couponError) {
      removeCoupon()
      renderCouponState(null)
      setCouponMessage(quote.couponError, 'error')
    } else if (code && quote.coupon) {
      renderCouponState(code)
    }
  }

  const refreshQuote = async () => {
    const items = cartPayload()
    if (items.length === 0) return
    showError($('quote-error'), '')
    try {
      const quote = await api.orders.quote({ items, couponCode: getCouponCode() || undefined })
      renderQuote(quote)
      $('place-order-btn').disabled = false
    } catch (err) {
      $('place-order-btn').disabled = true
      if (err instanceof ApiError && err.status === 401) {
        window.location.href = '/auth/login?redirect=/checkout'
        return
      }
      showError($('quote-error'), (err.message || 'No pudimos calcular tu pedido') + '. Revisa tu carrito.')
    }
  }

  // ── Cupón ─────────────────────────────────────────────────────
  const setCouponMessage = (text, type) => {
    const el = $('coupon-message')
    if (!el) return
    el.textContent = text || ''
    el.className = `coupon-message${type ? ' ' + type : ''}`
  }

  const renderCouponState = (code) => {
    $('applied-code').textContent = code || ''
    $('coupon-applied').hidden = !code
    $('coupon-code').hidden = !!code
    $('apply-coupon-btn').hidden = !!code
  }

  $('apply-coupon-btn')?.addEventListener('click', async () => {
    const code = $('coupon-code')?.value.trim().toUpperCase() || ''
    if (!code) return setCouponMessage('Ingresa un código', 'error')
    try {
      const coupon = await api.coupons.validate(code, lastQuote?.subtotal || 0)
      applyCoupon(code, coupon)
      setCouponMessage(
        coupon.type === 'PERCENTAGE' ? `${Number(coupon.value)}% de descuento aplicado` : `${money(coupon.value)} de descuento aplicado`,
        'success',
      )
      renderCouponState(code)
      await refreshQuote()
    } catch (err) {
      setCouponMessage(err.message || 'Cupón no válido', 'error')
    }
  })

  $('remove-coupon-btn')?.addEventListener('click', async () => {
    removeCoupon()
    renderCouponState(null)
    setCouponMessage('', '')
    if ($('coupon-code')) $('coupon-code').value = ''
    await refreshQuote()
  })

  // ── Métodos de pago disponibles ───────────────────────────────
  const loadPaymentMethods = async () => {
    try {
      const methods = await api.payments.methods()
      $('pm-wompi').hidden = !methods.wompi
      $('pm-mercadopago').hidden = !methods.mercadopago
      const first = document.querySelector(`.payment-option:not([hidden]) input[name="payment"]`)
      if (first) first.checked = true
      $('payment-unavailable').hidden = methods.wompi || methods.mercadopago
    } catch {
      // Si falla la consulta dejamos ambos visibles; el backend valida igual.
    }
  }

  // ── Inicio ───────────────────────────────────────────────────
  const init = async () => {
    const user = await bootstrapAuth()
    if (!user) {
      window.location.href = '/auth/login?redirect=/checkout'
      return
    }
    await ensureCartLoaded()
    if (cartItems.get().length === 0) {
      $('checkout-empty').hidden = false
      return
    }
    $('checkout-content').hidden = false
    if ($('full-name') && !$('full-name').value) $('full-name').value = user.name || ''
    const saved = getCouponCode()
    if (saved) renderCouponState(saved)
    await Promise.all([refreshQuote(), loadPaymentMethods()])
  }
  init()

  // ── Confirmar pedido y pagar ─────────────────────────────────
  const startPayment = async (orderId, method) => {
    const res = method === 'mercadopago'
      ? await api.payments.createPreference(orderId)
      : await api.payments.wompi.createCheckout(orderId)
    if (!res?.checkoutUrl) throw new Error('No se recibió el enlace de pago')
    return res.checkoutUrl
  }

  $('place-order-btn')?.addEventListener('click', async () => {
    if (placing) return
    const errorEl = $('checkout-error')
    const btn = $('place-order-btn')
    showError(errorEl, '')

    const fullName = $('full-name')?.value.trim() || ''
    const phone = ($('phone')?.value || '').replace(/[^\d+]/g, '')
    const street = $('street')?.value.trim() || ''
    const zipCode = $('zipCode')?.value.trim() || ''
    // Respaldo: leer los <select> del componente por si el evento no llegó.
    const [depSelect, munSelect] = document.querySelectorAll('.ubicacion-select select')
    const departamento = ($('address-departamento')?.value || depSelect?.value || '').trim()
    const municipio = ($('address-municipio')?.value || munSelect?.value || '').trim()

    if (!fullName || !phone || !street || !departamento || !municipio) {
      return showError(errorEl, 'Completa nombre, teléfono, dirección, departamento y municipio.')
    }
    if (!/^(\+?57)?3\d{9}$|^(\+?57)?[1-8]\d{6,9}$/.test(phone)) {
      return showError(errorEl, 'Ingresa un teléfono colombiano válido (ej. 300 123 4567).')
    }
    if (!$('accept-terms')?.checked) {
      return showError(errorEl, 'Debes aceptar los términos y autorizar el tratamiento de tus datos para continuar.')
    }

    const method = document.querySelector('input[name="payment"]:checked')?.value || 'wompi'
    placing = true
    btn.disabled = true
    btn.textContent = 'Creando pedido…'

    let order = null
    try {
      order = await api.orders.create({
        items: cartPayload(),
        couponCode: getCouponCode() || undefined,
        acceptTerms: true,
        address: { fullName, phone, street, zipCode: zipCode || undefined, departamento, municipio, label: 'Casa' },
      })

      btn.textContent = 'Conectando con la pasarela…'
      const url = await startPayment(order.id, method)
      removeCoupon()
      // El carrito NO se vacía aquí: se vacía cuando el pago es aprobado.
      window.location.href = url
    } catch (err) {
      placing = false
      btn.disabled = false
      btn.textContent = 'Confirmar pedido y pagar'

      if (order) {
        // La orden existe pero no se pudo abrir la pasarela: no crear otra.
        window.location.href = `/perfil/ordenes/${order.id}?pago=error`
        return
      }
      if (err instanceof ApiError && err.code === 'EMAIL_NOT_VERIFIED') {
        return showError(errorEl, `${escapeHtml(err.message)}.<br><a href="/auth/verify-email" class="checkout-verify-link">Reenviar enlace de verificación →</a>`, true)
      }
      if (err instanceof ApiError && err.code === 'INSUFFICIENT_STOCK') {
        await refreshQuote()
      }
      showError(errorEl, err.message || 'No pudimos crear tu pedido. Intenta de nuevo.')
    }
  })

  // Si el usuario vuelve con "atrás" desde la pasarela, re-habilitar el botón.
  window.addEventListener('pageshow', (e) => {
    if (e.persisted) {
      placing = false
      const btn = $('place-order-btn')
      if (btn) { btn.disabled = false; btn.textContent = 'Confirmar pedido y pagar' }
    }
  })

</script>

<style>
  .sr-only {
    position:    absolute;
    width:       1px;
    height:      1px;
    padding:     0;
    margin:      -1px;
    overflow:    hidden;
    clip:        rect(0, 0, 0, 0);
    white-space: nowrap;
    border:      0;
  }

  .checkout-page {
    padding-top:    calc(var(--header-height) + 1.5rem);
    padding-bottom: 3rem;
    max-width:      var(--max-width);
    margin:         0 auto;
  }

  .page-title {
    font-family:   var(--font-serif);
    font-size:     1.6rem;
    font-weight:   600;
    color:         var(--color-black);
    margin-bottom: 1.5rem;
  }

  .checkout-empty {
    flex-direction:  column;
    align-items:     center;
    justify-content: center;
    gap:             1rem;
    padding:         4rem 1rem;
    text-align:      center;
    color:           var(--color-gray-500);
  }

  .checkout-layout {
    display:               grid;
    grid-template-columns: 1fr;
    gap:                   2rem;
    align-items:           start;
  }

  .form-section {
    margin:        0 0 1.5rem 0;
    padding:       0 0 1.5rem 0;
    border:        none;
    border-bottom: 1.5px solid var(--color-gray-200);
  }
  .form-section:last-of-type { border-bottom: none; }

  .section-title {
    font-size:     0.95rem;
    font-weight:   600;
    color:         var(--color-black);
    margin-bottom: 1rem;
    padding:       0;
  }

  .form-grid {
    display:               grid;
    grid-template-columns: 1fr;
    gap:                   0.85rem;
  }

  .payment-methods {
    display:        flex;
    flex-direction: column;
    gap:            0.6rem;
  }

  .payment-option {
    cursor:     pointer;
    display:    block;
    position:   relative;
  }

  .payment-option input {
    position:        absolute;
    opacity:         0;
    pointer-events:  none;
  }

  .payment-card {
    display:       flex;
    align-items:   center;
    gap:           0.85rem;
    padding:       0.85rem 1rem;
    border:        1.5px solid var(--color-gray-200);
    border-radius: var(--radius-lg);
    transition:    all var(--transition);
  }

  .payment-option input:checked + .payment-card {
    border-color: var(--color-black);
    background:   var(--color-gray-50);
  }

  .payment-option input:focus-visible + .payment-card {
    outline:        2px solid var(--color-black);
    outline-offset: 2px;
  }

  .payment-icon {
    width:           44px;
    height:          44px;
    display:         flex;
    align-items:     center;
    justify-content: center;
    background:      var(--color-gray-100);
    border-radius:   var(--radius-md);
    color:           var(--color-black);
  }

  .payment-name { font-size: 0.9rem;  font-weight: 500; color: var(--color-black); margin: 0; }
  .payment-desc { font-size: 0.78rem; color: var(--color-gray-500); margin: 0; }

  .checkout-error {
    background:    #fee2e2;
    color:         #991b1b;
    padding:       0.75rem 1rem;
    border-radius: var(--radius-md);
    font-size:     0.875rem;
    margin-bottom: 0.85rem;
  }

  .consent-row { display: flex; gap: 0.6rem; align-items: flex-start; font-size: 0.8rem; color: var(--color-gray-600); margin: 0 0 1rem; line-height: 1.45; cursor: pointer; }
  .consent-row input { margin-top: 0.2rem; width: 18px; height: 18px; flex-shrink: 0; }
  .consent-row a { text-decoration: underline; }
  .checkout-hint { font-size: 0.75rem; color: var(--color-gray-500); text-align: center; margin-top: 0.6rem; }
  .tax-note { font-size: 0.72rem; color: var(--color-gray-500); text-align: right; margin: 0.25rem 0 0; }
  .payment-option[hidden] { display: none; }
  #place-order-btn:disabled { opacity: 0.6; cursor: not-allowed; }
  .checkout-verify-link {
    display:        inline-block;
    margin-top:     0.4rem;
    color:          #991b1b;
    font-weight:    600;
    text-decoration: underline;
  }

  .btn-full { width: 100%; padding: 0.95rem 1.5rem; }

  .order-summary {
    background:    var(--color-white);
    border:        1.5px solid var(--color-gray-200);
    border-radius: var(--radius-lg);
    padding:       1.25rem;
  }

  .summary-title {
    font-size:     1rem;
    font-weight:   600;
    color:         var(--color-black);
    margin-bottom: 0.85rem;
  }

  .order-item {
    display:     flex;
    align-items: center;
    gap:         0.6rem;
    padding:     0.5rem 0;
  }

  .order-item-image {
    position:      relative;
    width:         50px;
    height:        64px;
    border-radius: var(--radius-md);
    overflow:      hidden;
    background:    var(--color-gray-100);
    flex-shrink:   0;
  }
  .order-item-image img { width: 100%; height: 100%; object-fit: cover; }
  .order-item-placeholder {
    width:        100%;
    height:       100%;
    display:      flex;
    align-items:  center;
    justify-content: center;
    color:        var(--color-gray-400);
  }

  .order-item-qty {
    position:        absolute;
    top:             -6px;
    right:           -6px;
    background:      var(--color-black);
    color:           white;
    font-size:       0.6rem;
    font-weight:     600;
    min-width:       18px;
    height:          18px;
    padding:         0 5px;
    border-radius:   var(--radius-full);
    display:         flex;
    align-items:     center;
    justify-content: center;
  }

  .order-item-info { flex: 1; min-width: 0; }
  .order-item-name    { font-size: 0.85rem; font-weight: 500; color: var(--color-black); margin: 0; }
  .order-item-variant { font-size: 0.7rem; color: var(--color-gray-500); margin: 0; }
  .order-item-price   { font-size: 0.85rem; font-weight: 600; color: var(--color-black); margin: 0; white-space: nowrap; }

  .summary-divider {
    height:     1.5px;
    background: var(--color-gray-200);
    margin:     0.85rem 0;
  }

  .summary-row {
    display:         flex;
    justify-content: space-between;
    font-size:       0.9rem;
    color:           var(--color-gray-600);
    margin-bottom:   0.6rem;
  }

  .discount-amount { color: var(--color-success); }
  .shipping-free   { color: var(--color-success); font-weight: 500; }

  .coupon-section { margin-bottom: 0.85rem; }
  .coupon-input-group { display: flex; gap: 0.5rem; }
  .coupon-input {
    flex:        1;
    min-width:   0;
    padding:     0.5rem 0.75rem;
    border:      1.5px solid var(--color-gray-200);
    border-radius: var(--radius-md);
    font-size:   0.85rem;
    text-transform: uppercase;
  }
  .coupon-input:focus { outline: none; border-color: var(--color-black); }
  .coupon-btn {
    padding:       0.5rem 1rem;
    background:    var(--color-black);
    color:         white;
    border:        none;
    border-radius: var(--radius-md);
    font-size:     0.85rem;
    font-weight:   500;
    cursor:        pointer;
  }
  .coupon-btn:disabled { opacity: 0.6; cursor: not-allowed; }

  .coupon-message {
    font-size:    0.75rem;
    margin-top:   0.4rem;
    min-height:   1em;
  }
  .coupon-message.error   { color: #991b1b; }
  .coupon-message.success { color: #166534; }

  .coupon-applied {
    display:         flex;
    align-items:     center;
    justify-content: space-between;
    padding:         0.5rem 0.75rem;
    background:      #dcfce7;
    border:          1px solid var(--color-success);
    border-radius:   var(--radius-md);
    font-size:       0.85rem;
    color:           #166534;
