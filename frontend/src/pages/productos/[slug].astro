---
import ShopLayout from '../../layouts/ShopLayout.astro'
import Icon from '../../components/ui/Icon.astro'
import { api } from '../../lib/api.js'

const { slug } = Astro.params

let product = null
let error = false

try {
  product = await api.products.detail(slug)
} catch (e) {
  error = true
}

if (!product || error) {
  return Astro.redirect('/productos')
}

const mainImage   = product.images?.find((i) => i.isMain) || product.images?.[0]
const sizes       = [...new Set(product.variants?.map((v) => v.size).filter(Boolean))]
const colors      = [...new Set(product.variants?.map((v) => v.color).filter(Boolean))]

const formattedPrice = Number(product.price).toLocaleString('es-CO')
---

<ShopLayout title={product.name} description={product.description}>
  <div class="product-page container">

    <nav class="breadcrumb" aria-label="Migas de pan">
      <a href="/">Inicio</a>
      <span aria-hidden="true">›</span>
      <a href="/productos">Productos</a>
      <span aria-hidden="true">›</span>
      <a href={`/productos?category=${product.category?.slug}`}>{product.category?.name}</a>
      <span aria-hidden="true">›</span>
      <span aria-current="page">{product.name}</span>
    </nav>

    <div class="product-layout">

      <div class="product-gallery">
        <div class="main-image">
          <img
            id="main-img"
            src={mainImage?.url}
            alt={product.name}
            fetchpriority="high"
          />
        </div>
        {product.images && product.images.length > 1 && (
          <div class="thumbnails" role="tablist" aria-label="Imágenes del producto">
            {product.images.map((img, i) => (
              <button
                type="button"
                role="tab"
                class={`thumbnail ${i === 0 ? 'active' : ''}`}
                data-src={img.url}
                aria-label={`Imagen ${i + 1} de ${product.images.length}`}
                aria-selected={i === 0 ? 'true' : 'false'}
              >
                <img src={img.url} alt="" />
              </button>
            ))}
          </div>
        )}
      </div>

      <div class="product-info">

        <div class="product-meta">
          <a href={`/productos?category=${product.category?.slug}`} class="product-category-link">
            {product.category?.name}
          </a>
          {product.isFeatured && <span class="badge-featured">Destacado</span>}
        </div>

        <h1 class="product-title">{product.name}</h1>

        <p class="product-price">
          <span class="currency-symbol">$</span>{formattedPrice} <span class="currency">COP</span>
        </p>

        {product.description && (
          <p class="product-description">{product.description}</p>
        )}

        {sizes.length > 0 && (
          <div class="option-group">
            <label class="option-label">
              Talla: <span id="selected-size" class="selected-value">—</span>
            </label>
            <div class="size-grid" role="radiogroup" aria-label="Seleccionar talla">
              {sizes.map((size) => (
                <button
                  type="button"
                  class="size-btn"
                  data-size={size}
                  role="radio"
                  aria-checked="false"
                >
                  {size}
                </button>
              ))}
            </div>
          </div>
        )}

        {colors.length > 0 && (
          <div class="option-group">
            <label class="option-label">
              Color: <span id="selected-color" class="selected-value">—</span>
            </label>
            <div class="color-grid" role="radiogroup" aria-label="Seleccionar color">
              {colors.map((color) => (
                <button
                  type="button"
                  class="color-btn"
                  data-color={color}
                  role="radio"
                  aria-checked="false"
                >
                  {color}
                </button>
              ))}
            </div>
          </div>
        )}

        <div class="option-group">
          <label class="option-label">Cantidad</label>
          <div class="quantity-selector">
            <button type="button" id="qty-minus" class="qty-btn" aria-label="Disminuir cantidad">−</button>
            <span id="qty-display" aria-live="polite">1</span>
            <button type="button" id="qty-plus" class="qty-btn" aria-label="Aumentar cantidad">+</button>
          </div>
        </div>

        <div class="product-actions">
          <button type="button" class="btn btn-primary btn-full" id="add-to-cart-btn">
            Agregar al carrito
          </button>
          <button type="button" class="btn btn-outline btn-full" id="buy-now-btn">
            Comprar ahora
          </button>
        </div>

        <div id="action-message" class="action-message" role="status" aria-live="polite" hidden></div>

        <div class="product-details">
          <div class="detail-item">
            <Icon name="truck" size={20} />
            <span>Envío a todo Colombia</span>
          </div>
          <div class="detail-item">
            <Icon name="refresh" size={20} />
            <span>Cambios y devoluciones en 30 días</span>
          </div>
          <div class="detail-item">
            <Icon name="lock" size={20} />
            <span>Pago seguro</span>
          </div>
        </div>

      </div>
    </div>
  </div>
</ShopLayout>

<script id="product-data" type="application/json" set:html={JSON.stringify({
  id:       product.id,
  slug:     product.slug,
  name:     product.name,
  price:    parseFloat(product.price),
  images:   product.images,
})} />

<script>
  import { addToCart } from '../../stores/cart.store.js'

  let selectedSize = null
  let selectedColor = null
  let quantity = 1

  const mainImg = document.getElementById('main-img')
  const thumbnails = document.querySelectorAll('.thumbnail')

  thumbnails.forEach((btn) => {
    btn.addEventListener('click', () => {
      const src = btn.dataset.src
      if (!src || !mainImg) return
      mainImg.src = src
      thumbnails.forEach((b) => {
        b.classList.remove('active')
        b.setAttribute('aria-selected', 'false')
      })
      btn.classList.add('active')
      btn.setAttribute('aria-selected', 'true')
    })
  })

  const sizeButtons = document.querySelectorAll('.size-btn')
  const sizeDisplay = document.getElementById('selected-size')
  sizeButtons.forEach((btn) => {
    btn.addEventListener('click', () => {
      sizeButtons.forEach((b) => {
        b.classList.remove('active')
        b.setAttribute('aria-checked', 'false')
      })
      btn.classList.add('active')
      btn.setAttribute('aria-checked', 'true')
      selectedSize = btn.dataset.size || null
      if (sizeDisplay) sizeDisplay.textContent = selectedSize || '—'
    })
  })

  const colorButtons = document.querySelectorAll('.color-btn')
  const colorDisplay = document.getElementById('selected-color')
  colorButtons.forEach((btn) => {
    btn.addEventListener('click', () => {
      colorButtons.forEach((b) => {
        b.classList.remove('active')
        b.setAttribute('aria-checked', 'false')
      })
      btn.classList.add('active')
      btn.setAttribute('aria-checked', 'true')
      selectedColor = btn.dataset.color || null
      if (colorDisplay) colorDisplay.textContent = selectedColor || '—'
    })
  })

  const qtyDisplay = document.getElementById('qty-display')
  const setQty = (q) => {
    quantity = Math.max(1, Math.min(10, q))
    if (qtyDisplay) qtyDisplay.textContent = String(quantity)
  }

  document.getElementById('qty-minus')?.addEventListener('click', () => setQty(quantity - 1))
  document.getElementById('qty-plus')?.addEventListener('click', () => setQty(quantity + 1))

  const messageEl = document.getElementById('action-message')
  const showMessage = (text, type) => {
    if (!messageEl) return
    messageEl.textContent = text
    messageEl.className = `action-message action-${type}`
    messageEl.hidden = false
    setTimeout(() => { messageEl.hidden = true }, 3000)
  }

  const product = JSON.parse(document.getElementById('product-data')?.textContent || '{}')

  document.getElementById('add-to-cart-btn')?.addEventListener('click', async () => {
    try {
      await addToCart(product, quantity, selectedSize, selectedColor)
      showMessage('¡Producto agregado al carrito!', 'success')
    } catch {
      showMessage('Error al agregar el producto', 'error')
    }
  })

  document.getElementById('buy-now-btn')?.addEventListener('click', async () => {
    try {
      await addToCart(product, quantity, selectedSize, selectedColor)
      window.location.href = '/carrito'
    } catch {
      showMessage('Error al procesar la compra', 'error')
    }
  })
</script>

<style>
  .product-page {
    padding-top:    calc(var(--header-height) + 1.5rem);
    padding-bottom: 3rem;
  }

  .breadcrumb {
    display:     flex;
    align-items: center;
    flex-wrap:   wrap;
    gap:         0.4rem;
    font-size:   0.8rem;
    color:       var(--color-gray-500);
    margin-bottom: 1.5rem;
  }
  .breadcrumb a:hover { color: var(--color-black); }
  .breadcrumb span { color: var(--color-gray-400); }

  .product-layout {
    display: grid;
    grid-template-columns: 1fr;
    gap:     2rem;
  }

  .main-image {
    aspect-ratio: 3/4;
    overflow:     hidden;
    border-radius: var(--radius-lg);
    background:   var(--color-gray-100);
  }
  .main-image img {
    width:      100%;
    height:     100%;
    object-fit: cover;
    transition: transform 400ms ease;
  }

  .thumbnails {
    display: flex;
    gap:     0.5rem;
    margin-top: 0.75rem;
    overflow-x: auto;
    padding-bottom: 0.25rem;
  }
  .thumbnail {
    flex-shrink:  0;
    width:        64px;
    height:       84px;
    border-radius: var(--radius-md);
    overflow:     hidden;
    border:       2px solid transparent;
    background:   transparent;
    padding:      0;
    cursor:       pointer;
    transition:   border-color var(--transition);
  }
  .thumbnail.active,
  .thumbnail:hover { border-color: var(--color-black); }
  .thumbnail img { width: 100%; height: 100%; object-fit: cover; }

  .product-meta {
    display:     flex;
    align-items: center;
    gap:         0.5rem;
    margin-bottom: 0.75rem;
    flex-wrap:   wrap;
  }
  .product-category-link {
    font-size:      0.7rem;
    font-weight:    600;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color:          var(--color-gray-500);
  }
  .product-category-link:hover { color: var(--color-black); }

  .badge-featured {
    font-size:     0.65rem;
    font-weight:   600;
    padding:       2px 8px;
    background:    var(--color-black);
    color:         white;
    border-radius: var(--radius-full);
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }

  .product-title {
    font-family:   var(--font-serif);
    font-size:     1.6rem;
    font-weight:   600;
    color:         var(--color-black);
    line-height:   1.2;
    margin-bottom: 0.75rem;
  }

  .product-price {
    font-size:     1.5rem;
    font-weight:   700;
    color:         var(--color-black);
    margin-bottom: 1rem;
    display:       flex;
    align-items:    baseline;
    gap:            0.25rem;
  }
  .currency-symbol { font-size: 1rem; font-weight: 500; color: var(--color-gray-500); }
  .currency {
    font-size:   0.85rem;
    font-weight: 400;
    color:       var(--color-gray-500);
  }

  .product-description {
    font-size:     0.95rem;
    color:         var(--color-gray-600);
    line-height:   1.7;
    margin-bottom: 1.5rem;
    padding-bottom: 1.5rem;
    border-bottom: 1.5px solid var(--color-gray-200);
  }

  .option-group { margin-bottom: 1.25rem; }

  .option-label {
    display:     block;
    font-size:   0.85rem;
    font-weight: 600;
    color:       var(--color-gray-800);
    margin-bottom: 0.75rem;
  }
  .selected-value { font-weight: 400; color: var(--color-gray-500); }

  .size-grid, .color-grid {
    display:   flex;
    flex-wrap: wrap;
    gap:       0.5rem;
  }

  .size-btn {
    min-width:     48px;
    height:        44px;
    padding:       0 0.75rem;
    border:        1.5px solid var(--color-gray-200);
    border-radius: var(--radius-md);
    font-size:     0.875rem;
    font-weight:   500;
    color:         var(--color-gray-600);
    transition:    all var(--transition);
    background:    var(--color-white);
  }
  .size-btn:hover,
  .size-btn.active {
    border-color: var(--color-black);
    background:   var(--color-black);
    color:        white;
  }

  .color-btn {
    padding:       0.5rem 1rem;
    border:        1.5px solid var(--color-gray-200);
    border-radius: var(--radius-full);
    font-size:     0.8rem;
    color:         var(--color-gray-600);
    transition:    all var(--transition);
    background:    var(--color-white);
  }
  .color-btn:hover,
  .color-btn.active {
    border-color: var(--color-black);
    color:        var(--color-black);
    font-weight:  500;
  }

  .quantity-selector {
    display:        flex;
    align-items:    center;
    gap:            1rem;
    width:          fit-content;
    border:         1.5px solid var(--color-gray-200);
    border-radius:  var(--radius-md);
    padding:        0.4rem 0.85rem;
  }
  .qty-btn {
    font-size:   1.2rem;
    color:       var(--color-gray-600);
    width:       24px;
    text-align:  center;
    transition:  color var(--transition);
    background:  none;
    border:      none;
    cursor:      pointer;
  }
  .qty-btn:hover { color: var(--color-black); }
  #qty-display {
    font-size:     1rem;
    font-weight:   600;
    min-width:     24px;
    text-align:    center;
  }

  .product-actions {
    display:        flex;
    flex-direction: column;
    gap:            0.75rem;
    margin-top:     1.5rem;
    margin-bottom:  1rem;
  }
  .btn-full { width: 100%; padding: 0.95rem 1.5rem; }

  .action-message {
    padding:       0.75rem 1rem;
    border-radius: var(--radius-md);
    font-size:     0.875rem;
    font-weight:   500;
    margin-top:    0.75rem;
  }
  .action-success { background: #dcfce7; color: #166534; }
  .action-error   { background: #fee2e2; color: #991b1b; }

  .product-details {
    display:        flex;
    flex-direction: column;
    gap:            0.75rem;
    margin-top:     1.5rem;
    padding-top:    1.5rem;
    border-top:     1.5px solid var(--color-gray-200);
  }
  .detail-item {
    display:     flex;
    align-items: center;
    gap:         0.75rem;
    font-size:   0.875rem;
    color:       var(--color-gray-600);
  }

  @media (min-width: 768px) {
    .product-page { padding-top: calc(var(--header-height) + 2rem); padding-bottom: 4rem; }
    .product-layout { gap: 2.5rem; }
    .product-title { font-size: 2rem; }
    .product-price { font-size: 1.8rem; }
    .thumbnail { width: 72px; height: 90px; }
  }

  @media (min-width: 1024px) {
    .product-layout {
      grid-template-columns: 1fr 1fr;
      gap:                   3rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .main-image img,
    .thumbnail { transition: none; }
  }
</style>