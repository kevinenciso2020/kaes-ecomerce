{
  "name": "ecommerce-ropa-backend",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "nodemon src/server.js",
    "build": "prisma generate",
    "start": "node src/server.js",
    "start:prod": "prisma migrate deploy && node src/server.js",
    "db:migrate": "npx prisma migrate dev",
    "db:push": "npx prisma db push",
    "db:studio": "npx prisma studio",
    "db:seed": "node prisma/seed.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "cleanup:test-data": "node scripts/cleanup-test-data.js",
    "test:db": "vitest run --config vitest.db.config.js"
  },
  "prisma": {
    "seed": "node prisma/seed.js"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "@sentry/node": "^10.73.0",
    "axios": "^1.15.1",
    "bcryptjs": "^2.4.3",
    "cloudinary": "^2.9.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^17.4.2",
    "express": "^4.21.1",
    "express-rate-limit": "^7.4.1",
    "express-validator": "^7.2.0",
    "file-type": "^22.0.1",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "mercadopago": "^3.4.0",
    "multer": "^1.4.5-lts.1",
    "nodemailer": "^9.0.5",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "prisma": "5.22.0"
  },
  "devDependencies": {
    "@types/node": "^25.6.0",
    "@vitest/coverage-v8": "^4.1.11",
    "nodemon": "^3.1.7",
    "pino-pretty": "^13.1.3",
    "supertest": "^7.0.0",
    "vitest": "^4.1.11"
  },
  "engines": {
    "node": ">=20.18"
  }
}
