# ════════════════════════════════════════════════════════════════
#  Kaes Store — backend. Copia a .env (local) o cárgalas en Railway.
#  En producción el servidor NO arranca si falta alguna "requerida".
# ════════════════════════════════════════════════════════════════

# ── Servidor ─────────────────────────────────────────────────
NODE_ENV=production
PORT=3001
LOG_LEVEL=info                      # fatal|error|warn|info|debug

# ── URLs (requeridas) ────────────────────────────────────────
FRONTEND_URL=https://kaes-simplyeternal.co
BACKEND_URL=https://api.kaes-simplyeternal.co
# Otros orígenes permitidos (CORS/CSRF), separados por coma. Ej: www
ALLOWED_ORIGINS=https://www.kaes-simplyeternal.co

# Dominio compartido para las cookies de sesión. Con front en kaes-simplyeternal.co y API en
# api.kaes-simplyeternal.co usa ".kaes-simplyeternal.co": las cookies pasan a ser first-party (funcionan en
# Safari/iOS). Déjalo vacío mientras uses *.vercel.app + *.railway.app.
COOKIE_DOMAIN=

# Saltos de proxy delante del API (1 = Railway). Usa 2 sólo si api.* pasa por
# el proxy de Cloudflare (nube naranja). Recomendado: api.* en "DNS only" y 1.
TRUST_PROXY=1

# ── Base de datos Neon (requerida) ───────────────────────────
# ⚠️ Para desarrollo usa un BRANCH de Neon, nunca la base de producción.
DATABASE_URL=postgresql://user:password@host-pooler/neondb?sslmode=require
DIRECT_URL=postgresql://user:password@host/neondb?sslmode=require

# ── JWT (requeridas, mínimo 32 caracteres, distintas entre sí) ──
# Genera con: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_REFRESH_SECRET=
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ── Cloudinary (requeridas) ──────────────────────────────────
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ── Wompi (Web Checkout) ─────────────────────────────────────
# Panel de Wompi → Desarrolladores. Usa las de PRUEBA hasta terminar el
# checklist de sandbox. URL de eventos a configurar en el panel:
#   https://api.kaes-simplyeternal.co/api/v1/payments/wompi/webhook
WOMPI_PUBLIC_KEY=pub_test_xxxxxxxxxxxxx
WOMPI_PRIVATE_KEY=prv_test_xxxxxxxxxxxxx
WOMPI_INTEGRITY_SECRET=test_integrity_xxxxxxxxxxxxx
WOMPI_EVENTS_SECRET=test_events_xxxxxxxxxxxxx
# (opcional) sandbox|production — por defecto se deduce de la llave pública
WOMPI_ENV=

# ── MercadoPago (opcional) ───────────────────────────────────
# Si MP_ACCESS_TOKEN está vacío, MercadoPago se oculta del checkout.
# Secreto de firma: Tus integraciones → Webhooks → Clave secreta.
MP_ACCESS_TOKEN=
MP_WEBHOOK_SECRET=
MP_ENABLED=true

# ── Envío (COP) ──────────────────────────────────────────────
# 0 = envío gratis siempre. FREE_SHIPPING_FROM = gratis desde ese subtotal.
SHIPPING_FLAT_RATE=0
FREE_SHIPPING_FROM=0

# ── Órdenes ──────────────────────────────────────────────────
# Minutos antes de cancelar una orden sin pago (el checkout de la pasarela dura 60).
ORDER_EXPIRY_MINUTES=120
# Versión de la política de datos que acepta el cliente (Habeas Data)
PRIVACY_POLICY_VERSION=2026-09-21

# ── SSR (Vercel → API) ───────────────────────────────────────
# Secreto compartido con Vercel (misma variable allá, SIN prefijo PUBLIC_).
# Evita que el rate limit por IP bloquee las páginas renderizadas en Vercel.
SSR_API_KEY=

# ── Sentry ───────────────────────────────────────────────────
SENTRY_DSN=
# SENTRY_RELEASE=kaes-backend@1.0.0

# ── Email SMTP ───────────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM_EMAIL=pedidos@kaes-simplyeternal.co

# IVA: fuente oficial que revisa el job diario (opcional; hay un valor por defecto)
# TAX_SOURCE_URL=https://www.secretariasenado.gov.co/senado/basedoc/estatuto_tributario_pr014.html
# Correo que recibe el aviso si cambia el IVA (por defecto SMTP_FROM_EMAIL)
# TAX_ALERT_EMAIL=

# ── Facturación electrónica DIAN (software propio) ───────────
# Guía completa: docs/FACTURACION_ELECTRONICA.md. Apagada por defecto.
EINVOICE_ENABLED=false
# 2 = habilitación (pruebas), 1 = producción
EINVOICE_ENV=2
# Emisor (datos del RUT)
EINVOICE_ISSUER_NIT=
# EINVOICE_ISSUER_DV=            # opcional, se calcula del NIT
EINVOICE_ISSUER_NAME=            # razón social / nombre como aparece en el RUT
EINVOICE_ISSUER_TRADE_NAME=KAES
EINVOICE_ISSUER_PERSON_TYPE=1    # 1 = persona jurídica, 2 = persona natural
EINVOICE_ISSUER_TAX_LEVEL_CODE=R-99-PN   # responsabilidades (O-13;O-15;O-23;O-47 o R-99-PN)
EINVOICE_ISSUER_TAX_SCHEME=01    # 01 = responsable de IVA, ZZ = no responsable
EINVOICE_ISSUER_ADDRESS=
EINVOICE_ISSUER_DEPARTAMENTO=
EINVOICE_ISSUER_MUNICIPIO=
EINVOICE_ISSUER_POSTAL_ZONE=
EINVOICE_ISSUER_EMAIL=           # correo de recepción de facturas registrado en la DIAN
EINVOICE_ISSUER_PHONE=
# EINVOICE_ISSUER_MATRICULA=     # matrícula mercantil (opcional)
# Resolución de numeración (en habilitación: la de pruebas que muestra el portal)
EINVOICE_RESOLUTION_NUMBER=
EINVOICE_RESOLUTION_START=       # AAAA-MM-DD
EINVOICE_RESOLUTION_END=         # AAAA-MM-DD
EINVOICE_PREFIX=
EINVOICE_RANGE_FROM=
EINVOICE_RANGE_TO=
EINVOICE_TECHNICAL_KEY=
EINVOICE_CREDIT_NOTE_PREFIX=NC
# Software propio registrado en el portal de habilitación
EINVOICE_SOFTWARE_ID=
EINVOICE_SOFTWARE_PIN=
EINVOICE_TEST_SET_ID=
# Certificado de firma digital (npm run einvoice:cert -- archivo.p12)
EINVOICE_CERT_PEM_BASE64=
EINVOICE_KEY_PEM_BASE64=
# EINVOICE_KEY_PASSPHRASE=
# IVA del envío (0 = excluido). Confírmalo con tu contador.
EINVOICE_SHIPPING_TAX_RATE=0
# Medio de pago (tabla 13.3.4.2): ZZZ = otro, 48 = tarjeta crédito, 47 = transferencia
EINVOICE_PAYMENT_MEANS_CODE=ZZZ
# Correo que recibe alertas de rechazos (por defecto TAX_ALERT_EMAIL o SMTP_FROM_EMAIL)
# EINVOICE_ALERT_EMAIL=
