# ── Server ────────────────────────────────────────────────
NODE_ENV=production
PORT=3001

# ── Logging ─────────────────────────────────────────────────
# Niveles: fatal | error | warn | info | debug | trace | silent
# Por defecto: info en producción, debug en desarrollo.
# Tests Vitest imponen LOG_LEVEL=silent automáticamente.
LOG_LEVEL=info

# ── URLs ──────────────────────────────────────────────────
FRONTEND_URL=https://tu-dominio.vercel.app
BACKEND_URL=https://tu-backend.up.railway.app

# ── Database Neon ────────────────────────────────────────
DIRECT_URL=postgresql://user:password@host/neondb?sslmode=require
DATABASE_URL=postgresql://user:password@host-pooler/neondb?sslmode=require

# ── JWT ───────────────────────────────────────────────────
JWT_SECRET=your-jwt-secret-here
JWT_REFRESH_SECRET=your-refresh-secret-here

# ── Cloudinary ────────────────────────────────────────────
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# ── MercadoPago ───────────────────────────────────────────
MP_ACCESS_TOKEN=your-access-token
MP_WEBHOOK_SECRET=your-webhook-secret
MP_PUBLIC_KEY=your-public-key

# ── Wompi ─────────────────────────────────────────────────
WOMPI_ENV=production
WOMPI_PUBLIC_KEY=pub_prod_xxxxxxxxxxxxx
WOMPI_PRIVATE_KEY=prv_prod_xxxxxxxxxxxxx
WOMPI_WEBHOOK_SECRET=your-webhook-secret

# ── Email SMTP ────────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
SMTP_FROM_EMAIL=noreply@tu-dominio.com
